@model Vjezba.Web.ViewModels.HallFormViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
}

@if (isEdit)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="ui-field">
                    <label asp-for="Name" class="ui-field__label">Naziv dvorane <span style="color: var(--color-danger);">*</span></label>
                    <input asp-for="Name" class="ui-field__input" placeholder="npr. Dvorana 1" required />
                    <span asp-validation-for="Name" class="ui-field__validation"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ui-field">
                    <label asp-for="Capacity" class="ui-field__label">Kapacitet <span style="color: var(--color-danger);">*</span></label>
                    <input asp-for="Capacity" class="ui-field__input" type="number" min="1" placeholder="npr. 120" data-msg-min="Kapacitet mora biti veći od ili jednak 1." oninvalid="this.setCustomValidity(this.validity.rangeUnderflow ? 'Kapacitet mora biti veći od ili jednak 1.' : 'Kapacitet je obavezan.')" oninput="this.setCustomValidity('')" required />
                    <span asp-validation-for="Capacity" class="ui-field__validation"></span>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="ui-field">
                    <label class="ui-field__label">&nbsp;</label>
                    <label class="d-flex align-items-center gap-2">
                        <input asp-for="Supports3D" type="checkbox" />
                        <span>Podrška za 3D</span>
                    </label>
                </div>
            </div>
            <div class="col-12">
                @await Html.PartialAsync("_AutocompleteSelect", Model.CinemaSelector)
            </div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ui-btn ui-btn--secondary">Odustani</a>
        </div>
    </form>
}
else
{
    <form asp-action="Create" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="ui-field">
                    <label asp-for="Name" class="ui-field__label">Naziv dvorane <span style="color: var(--color-danger);">*</span></label>
                    <input asp-for="Name" class="ui-field__input" placeholder="npr. Dvorana 1" required />
                    <span asp-validation-for="Name" class="ui-field__validation"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ui-field">
                    <label asp-for="Capacity" class="ui-field__label">Kapacitet <span style="color: var(--color-danger);">*</span></label>
                    <input asp-for="Capacity" class="ui-field__input" type="number" min="1" placeholder="npr. 120" data-msg-min="Kapacitet mora biti veći od ili jednak 1." oninvalid="this.setCustomValidity(this.validity.rangeUnderflow ? 'Kapacitet mora biti veći od ili jednak 1.' : 'Kapacitet je obavezan.')" oninput="this.setCustomValidity('')" required />
                    <span asp-validation-for="Capacity" class="ui-field__validation"></span>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="ui-field">
                    <label class="ui-field__label">&nbsp;</label>
                    <label class="d-flex align-items-center gap-2">
                        <input asp-for="Supports3D" type="checkbox" />
                        <span>Podrška za 3D</span>
                    </label>
                </div>
            </div>
            <div class="col-12">
                @await Html.PartialAsync("_AutocompleteSelect", Model.CinemaSelector)
            </div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <a asp-action="Index" class="ui-btn ui-btn--secondary">Odustani</a>
            <button type="submit" class="ui-btn ui-btn--primary">Spremi dvoranu</button>
        </div>
    </form>
}
