@model Vjezba.Model.Entities.Hall

@{
    ViewData["Title"] = "Uredi dvoranu";
    var cinemas = ViewBag.Cinemas as List<Vjezba.Model.Entities.Cinema> ?? new List<Vjezba.Model.Entities.Cinema>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 entity-form">
            <div class="cinema-card animate-fade-in-up">
                <div class="cinema-card-header">Uredi dvoranu</div>
                <div class="cinema-card-body">
                    <form asp-action="Edit" method="post" class="ui-form"
                          onsubmit="return CinemaUI.validateForm(this);">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3"
                             style="background-color: rgba(255,0,0,0.1); border-radius: 4px;"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="ui-field"><label asp-for="Name" class="ui-field__label">Naziv dvorane <span
                                    style="color: #ef4444;">*</span></label><input asp-for="Name"
                                                                                   class="ui-field__input" required /><span class="ui-field__validation"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="ui-field"><label asp-for="Capacity" class="ui-field__label">Kapacitet <span
                                    style="color: #ef4444;">*</span></label><input asp-for="Capacity"
                                                                                   class="ui-field__input" type="number" min="1" required /><span
                                    class="ui-field__validation"></span></div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <div class="ui-field"><label class="ui-field__label">&nbsp;</label><label
                                        class="d-flex align-items-center gap-2"><input asp-for="Supports3D"
                                                                                       type="checkbox" /><span>Podrška za 3D</span></label></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="ui-field"><label asp-for="CinemaId" class="ui-field__label">Kino <span
                                            style="color: #ef4444;">*</span></label><select asp-for="CinemaId"
                                                                                        class="ui-field__input" required>
                                            <option value="">Odaberite kino</option>@foreach (var cinema in cinemas) { if
                                            (cinema.Id == Model.CinemaId) {
                                                <option value="@cinema.Id" selected>@cinema.Name
                                                </option>
                                            } else
                                            {

                                                <option value="@cinema.Id">@cinema.Name</option>
                                            }
                                        }
                                    </select><span class="ui-field__validation"></span></div>
                                </div>
                            </div>

                            <div class="ui-actions mt-4 pt-3 border-top ui-actions--stack-mobile">
                                <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
                                <a asp-action="Details" asp-route-id="@Model.Id"
                                   class="ui-btn ui-btn--secondary">Odustani</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>