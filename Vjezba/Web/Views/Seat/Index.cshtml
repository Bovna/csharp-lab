@model List<Vjezba.Model.Entities.Seat>

@{
    ViewData["Title"] = "Sjedala";
    var selectedSeatType = ViewBag.SelectedSeatType as string;
    var search = ViewBag.Search as string;
}

<div class="container py-4 animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
        <div>
            <h1 class="h3 mb-1" style="color: var(--color-accent); letter-spacing: 1px; text-transform: uppercase;">
                Popis sjedala</h1>
            </div>
            <a asp-action="Create" class="ui-btn ui-btn--primary">+ Dodaj novo sjedalo</a>
        </div>

        <div class="cinema-card animate-fade-in-up mb-4" style="animation-delay: 0.05s;">
            <div class="cinema-card-header">Pretraživanje</div>
            <div class="cinema-card-body">
                <form asp-action="Index" method="get" class="ui-form entity-index-search" data-ajax-search-form
                      data-ajax-results-target="#seat-index-results">
                    <div class="row g-4 align-items-end">
                        <div class="col-12 col-lg-7">
                            <div class="ui-field mb-0">
                                <label for="seatSearch" class="ui-field__label">Oznaka, dvorana ili kino</label>
                                <input id="seatSearch" name="search" value="@search" class="ui-field__input" type="search"
                                       placeholder="Pretražite sjedala..." autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="ui-field mb-0">
                                <label for="seatType" class="ui-field__label">Tip sjedala</label>
                                <select id="seatType" name="seatType" class="ui-field__input"
                                        onchange="this.form.requestSubmit()">
                                    <option value="">Svi tipovi</option>
                                    @if (string.Equals(selectedSeatType, "Standard", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="Standard" selected>Standard</option>
                                    }
                                    else
                                    {
                                        <option value="Standard">Standard</option>
                                    }

                                    @if (string.Equals(selectedSeatType, "Vip", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="Vip" selected>Vip</option>
                                    }
                                    else
                                    {
                                        <option value="Vip">Vip</option>
                                    }

                                    @if (string.Equals(selectedSeatType, "Couple", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="Couple" selected>Couple</option>
                                    }
                                    else
                                    {
                                        <option value="Couple">Couple</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="seat-index-results" data-ajax-search-results-container>
            @await Html.PartialAsync("_IndexResults", Model)
        </div>
