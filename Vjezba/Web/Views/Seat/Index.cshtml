@model List<Vjezba.Model.Entities.Seat>

@{
    ViewData["Title"] = "Sjedala";
}

<div class="container py-4 animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
        <h1 class="h3 mb-0" style="color: var(--color-accent); letter-spacing: 1px; text-transform: uppercase;">Popis
            sjedala</h1>
            <span class="cinema-badge">Ukupno: @Model.Count</span>
        </div>

        <div class="cinema-card animate-fade-in-up mb-4" style="animation-delay: 0.05s;">
            <div class="cinema-card-header">Filtriranje po tipu sjedala</div>
            <div class="cinema-card-body">
                <form method="get" asp-action="Index" class="ui-form">
                    <div class="ui-field">
                        <label for="seatType" class="ui-field__label">Tip sjedala</label>
                        <select id="seatType" name="seatType" class="ui-field__input" onchange="this.form.submit()">
                            <option value="">Svi tipovi</option>
                            @if (string.Equals((string?)ViewBag.SelectedSeatType, "Standard",
                                                                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Standard" selected>Standard</option>
                            }
                            else
                            {
                                <option value="Standard">Standard</option>
                            }
                            @if (string.Equals((string?)ViewBag.SelectedSeatType, "Vip",
                                                                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Vip" selected>Vip</option>
                            }
                            else
                            {
                                <option value="Vip">Vip</option>
                            }
                            @if (string.Equals((string?)ViewBag.SelectedSeatType, "Couple",
                                                                                StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Couple" selected>Couple</option>
                            }
                            else
                            {
                                <option value="Couple">Couple</option>
                            }
                        </select>
                    </div>

                </form>
            </div>
        </div>

        <div class="cinema-card">
            <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
                <table class="ui-table entity-index-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kino</th>
                            <th>Dvorana</th>
                            <th>Oznaka sjedala</th>
                            <th>Tip sjedala</th>
                            <th>Dodatno</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var seat in Model)
                        {
                            <tr>
                                <td class="text-muted">@seat.Id</td>
                                <td>@(seat.Hall?.Cinema?.Name ?? "-")</td>
                                <td>@(seat.Hall?.Name ?? "-")</td>
                                <td>@seat.RowLabel@seat.SeatNumber</td>
                                <td>@seat.SeatType</td>
                                <td class="ui-table__actions">
                                    <a asp-action="Details" asp-route-id="@seat.Id" class="ui-btn ui-btn--primary"
                                       style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">Detalji</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-5 pt-3 text-end">
            <a asp-action="Create" class="ui-btn ui-btn--primary">+ Dodaj novo sjedalo</a>
        </div>
    </div>

    <script>
        function handleDeleteClick(event, message) {
            event.preventDefault();
            CinemaUI.showConfirm({
                title: 'Potvrda brisanja',
                body: message,
                onConfirm: () => event.target.form.submit()
            });
        }
    </script>
