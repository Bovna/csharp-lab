@model List<Vjezba.Model.Entities.Cinema>
<section class="cinema-directory" data-ajax-search-results aria-live="polite">
 <p>Prikazano kina: @Model.Count</p>
 @if(Model.Any()){<div class="cinema-directory__grid">@foreach(var cinema in Model){<article class="cinema-directory__card"><p class="cinema-directory__city">@cinema.City</p><h2>@cinema.Name</h2><p>@cinema.Street @cinema.HouseNumber</p><dl><dt>E-posta</dt><dd>@cinema.Email</dd><dt>Telefon</dt><dd>@cinema.Phone</dd></dl><div class="ui-actions ui-actions--stack-mobile"><a class="ui-btn ui-btn--primary" asp-controller="TicketBuilder" asp-action="Movies" asp-route-cinemaId="@cinema.Id">Odaberi film</a>@if(User.Identity?.IsAuthenticated==true){<a class="ui-btn ui-btn--secondary" asp-action="Details" asp-route-id="@cinema.Id">Detalji</a>}</div></article>}</div>}else{<div class="ui-empty-state">Nema kina koja odgovaraju pretrazi.</div>}
</section>
