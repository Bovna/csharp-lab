@model List<Vjezba.Model.Entities.Cinema>

<div class="cinema-card animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="cinema-card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <span>Rezultati</span>
        <span class="cinema-badge">Prikazano: @Model.Count</span>
    </div>
    <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
        <table class="ui-table entity-index-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Naziv</th>
                    <th>Grad</th>
                    <th>Adresa</th>
                    <th>E-pošta</th>
                    <th>Telefon</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var cinema in Model)
                    {
                        <tr>
                            <td class="text-muted">@cinema.Id</td>
                            <td>@cinema.Name</td>
                            <td>@cinema.City</td>
                            <td>@cinema.Street @cinema.HouseNumber</td>
                            <td>@cinema.Email</td>
                            <td>@cinema.Phone</td>
                            <td class="ui-table__actions"><a asp-action="Details" asp-route-id="@cinema.Id"
                                                                 class="ui-btn ui-btn--primary">Detalji</a></td>
                            </tr>
                        }
                    }
                else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Nema rezultata pretrage.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>