@model Vjezba.Model.Entities.Cinema

@{
    ViewData["Title"] = "Uredi kino";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="cinema-card animate-fade-in-up">
                <div class="cinema-card-header">Uredi kino</div>
                <div class="cinema-card-body">
                    <form asp-action="Edit" method="post" class="ui-form"
                          onsubmit="return CinemaUI.validateForm(this);">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3"
                             style="background-color: rgba(255,0,0,0.1); border-radius: 4px;"></div>

                        <div class="mb-5">
                            <h5 class="mb-3"
                                style="color: var(--color-accent); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                Osnovne informacije</h5>
                                <div class="ui-field">
                                    <label asp-for="Name" class="ui-field__label">Naziv kina <span
                                        style="color: #ef4444;">*</span></label>
                                        <input asp-for="Name" class="ui-field__input" required />
                                        <span class="ui-field__validation"></span>
                                    </div>

                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <div class="ui-field">
                                                <label asp-for="City" class="ui-field__label">Grad <span
                                                    style="color: #ef4444;">*</span></label>
                                                    <input asp-for="City" class="ui-field__input" required />
                                                    <span class="ui-field__validation"></span>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="ui-field">
                                                    <label asp-for="PostalCode" class="ui-field__label">Poštanski broj <span
                                                        style="color: #ef4444;">*</span></label>
                                                        <input asp-for="PostalCode" class="ui-field__input" required />
                                                        <span class="ui-field__validation"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-5">
                                            <h5 class="mb-3"
                                                style="color: var(--color-accent); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                                Adresa i kontakt</h5>
                                                <div class="row g-4">
                                                    <div class="col-md-8">
                                                        <div class="ui-field">
                                                            <label asp-for="Street" class="ui-field__label">Ulica <span
                                                                style="color: #ef4444;">*</span></label>
                                                                <input asp-for="Street" class="ui-field__input" required />
                                                                <span class="ui-field__validation"></span>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-4">
                                                            <div class="ui-field">
                                                                <label asp-for="HouseNumber" class="ui-field__label">Kućni broj <span
                                                                    style="color: #ef4444;">*</span></label>
                                                                    <input asp-for="HouseNumber" class="ui-field__input" required />
                                                                    <span class="ui-field__validation"></span>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <div class="ui-field">
                                                                    <label asp-for="Email" class="ui-field__label">E-pošta <span
                                                                        style="color: #ef4444;">*</span></label>
                                                                        <input asp-for="Email" class="ui-field__input" required />
                                                                        <span class="ui-field__validation"></span>
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <div class="ui-field">
                                                                        <label asp-for="Phone" class="ui-field__label">Telefon <span
                                                                            style="color: #ef4444;">*</span></label>
                                                                            <input asp-for="Phone" class="ui-field__input" required />
                                                                            <span class="ui-field__validation"></span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="ui-actions mt-4 pt-3 border-top">
                                                                <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
                                                                <a asp-action="Details" asp-route-id="@Model.Id"
                                                                   class="ui-btn ui-btn--secondary">Odustani</a>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
