@model Vjezba.Model.Entities.Cinema

@{
    ViewData["Title"] = "Detalji kina";
    var hallsCount = Model.Halls.Count;
    var supports3DCount = Model.Halls.Count(h => h.Supports3D);
}

<div class="container py-4 animate-fade-in-up entity-details-page">
    <section class="entity-hero entity-hero--venue">
        <div class="entity-hero__content">
            <p class="entity-hero__eyebrow">Kino</p>
            <h1 class="entity-hero__title">@Model.Name</h1>
            <p class="entity-hero__subtitle">@Model.City, @Model.Street @Model.HouseNumber</p>
            <p class="venue-tagline">Atmosferski pregled lokacije, dvorana i 3D kapaciteta.</p>
        </div>
        <div class="ui-actions ui-actions--stack-mobile">
            <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
            <a asp-controller="Hall" asp-action="Create" class="ui-btn ui-btn--primary">Dodajte dvoranu</a>
        </div>
    </section>

    <section class="venue-address-board">
        <article>
            <p class="venue-address-board__label">Adresa</p>
            <p class="venue-address-board__value">@Model.Street @Model.HouseNumber, @Model.PostalCode @Model.City</p>
        </article>
        <article>
            <p class="venue-address-board__label">Kontakt</p>
            <p class="venue-address-board__value">@Model.Email • @Model.Phone</p>
        </article>
    </section>

    <section class="entity-kpi-grid">
        <article class="entity-kpi">
            <p class="entity-kpi__label">Dvorane</p>
            <p class="entity-kpi__value entity-kpi__value--accent">@hallsCount</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">3D dvorane</p>
            <p class="entity-kpi__value">@supports3DCount</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">Poštanski broj</p>
            <p class="entity-kpi__value">@Model.PostalCode</p>
        </article>
    </section>

    <div class="entity-details-grid">
        <article class="cinema-card entity-details-panel">
            <div class="cinema-card-header">Profil kina</div>
            <div class="cinema-card-body">
                <dl class="cinema-details-list">
                    <dt>ID</dt>
                    <dd>@Model.Id</dd>

                    <dt>Naziv</dt>
                    <dd>@Model.Name</dd>

                    <dt>Grad</dt>
                    <dd>@Model.City</dd>

                    <dt>Adresa</dt>
                    <dd>@Model.Street @Model.HouseNumber</dd>

                    <dt>Poštanski broj</dt>
                    <dd>@Model.PostalCode</dd>

                    <dt>E-pošta</dt>
                    <dd>@Model.Email</dd>

                    <dt>Telefon</dt>
                    <dd>@Model.Phone</dd>
                </dl>

                <div class="ui-actions ui-actions--center ui-actions--stack-mobile entity-actions">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="ui-btn ui-btn--primary">Uredi</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ui-btn ui-btn--danger"
                                    onclick="return handleDeleteCinema(event);">Obriši</button>
                        </form>
                    }
                </div>
            </div>
        </article>

        <article class="cinema-card entity-details-panel">
            <div class="cinema-card-header">Brze radnje</div>
            <div class="cinema-card-body">
                <div class="entity-meta">
                    <span class="entity-pill">Aktivno kino</span>
                    <span class="entity-pill @(supports3DCount > 0 ? "entity-pill--success" : "entity-pill--muted")">
                        @(supports3DCount > 0 ? "Ima 3D dvorane" : "Bez 3D dvorana")
                    </span>
                </div>
                <ul class="entity-link-list">
                    <li><a asp-controller="Hall" asp-action="Index">Pregled svih dvorana</a></li>
                    <li><a asp-controller="Hall" asp-action="Create">Dodajte novu dvoranu</a></li>
                    <li><a asp-controller="Screening" asp-action="Index">Pregled projekcija</a></li>
                </ul>
            </div>
        </article>
    </div>

    <article class="cinema-card animate-fade-in-up">
        <div class="cinema-card-header">Dvorane u kinu</div>
        <div class="cinema-table-wrapper">
            @if (Model.Halls.Any())
            {
                <table class="ui-table entity-related-table">
                    <thead>
                        <tr>
                            <th>Naziv</th>
                            <th>Kapacitet</th>
                            <th>3D</th>
                            <th>Akcija</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hall in Model.Halls.OrderBy(h => h.Name))
                        {
                            <tr>
                                <td>@hall.Name</td>
                                <td>@hall.Capacity mjesta</td>
                                <td>
                                    @if (hall.Supports3D)
                                    {
                                        <span class="entity-pill entity-pill--success">Da</span>
                                    }
                                    else
                                    {
                                        <span class="entity-pill entity-pill--muted">Ne</span>
                                    }
                                </td>
                                <td><a asp-controller="Hall" asp-action="Details" asp-route-id="@hall.Id">Otvori</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="cinema-card-body">
                    <p class="text-muted mb-0">Ovo kino još nema dodane dvorane.</p>
                </div>
            }
        </div>
    </article>
</div>

@section Scripts {
    <script>
        function handleDeleteCinema(event) {
            event.preventDefault();
            const form = event.currentTarget.form;

            if (!form) {
                return false;
            }
            CinemaUI.showConfirm({
                title: 'Potvrdite brisanje',
                body: 'Jeste li sigurni da želite trajno obrisati ovo kino?',
                onConfirm: () => HTMLFormElement.prototype.submit.call(form)
            });
            return false;
        }
    </script>
}
