@model List<Vjezba.Model.Entities.Movie>

<div class="cinema-card animate-fade-in-up" data-ajax-search-results>
    <div class="cinema-card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <span>Rezultati</span>
        <span class="cinema-badge">Prikazano: @Model.Count</span>
    </div>
    <div class="cinema-card-body p-0">
        <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
            <table class="ui-table entity-index-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Naslov</th>
                        <th>Žanr</th>
                        <th>Trajanje</th>
                        <th>Jezik</th>
                        <th>Izlazak</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var movie in Model)
                        {
                            <tr>
                                <td class="text-muted">@movie.Id</td>
                                <td style="font-weight: 500; color: #fff;">@movie.Title</td>
                                <td>@movie.Genre</td>
                                <td>@movie.DurationMinutes min</td>
                                <td>@movie.Language</td>
                                <td>@movie.ReleaseDate.ToString("dd.MM.yyyy")</td>
                                <td class="ui-table__actions">
                                    <a asp-action="Details" asp-route-id="@movie.Id" class="ui-btn ui-btn--primary"
                                       style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">Detalji</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted text-center py-4">Nema filmova koji odgovaraju pretrazi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>