@model List<Vjezba.Model.Entities.Movie>

<section class="movie-catalog" data-ajax-search-results aria-live="polite">
    <div class="movie-catalog__summary">Prikazano filmova: @Model.Count</div>
    @if (Model.Any())
    {
        <div class="movie-catalog__grid">
            @foreach (var movie in Model)
            {
                var poster = movie.Attachments.OrderByDescending(a => a.CreatedAt).Select(a => a.FilePath).FirstOrDefault();
                <article class="movie-catalog__card">
                    <div class="movie-catalog__poster">
                        @if (!string.IsNullOrWhiteSpace(poster))
                        { <img src="@poster" alt="Poster filma @movie.Title" loading="lazy" /> }
                        else { <span>@movie.Title</span> }
                    </div>
                    <div class="movie-catalog__body">
                        <h2>@movie.Title</h2>
                        <div class="movie-catalog__meta"><span>@movie.Genre</span><span>@movie.DurationMinutes min</span><span>@movie.Language</span><span>@movie.AgeRating</span></div>
                        <p>@movie.Description</p>
                        <div class="ui-actions ui-actions--stack-mobile">
                            <a class="ui-btn ui-btn--primary" asp-controller="TicketBuilder" asp-action="Index">Kupi ulaznice</a>
                            @if (User.Identity?.IsAuthenticated == true) { <a class="ui-btn ui-btn--secondary" asp-action="Details" asp-route-id="@movie.Id">Detalji</a> }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else { <div class="ui-empty-state">Nema filmova koji odgovaraju pretrazi.</div> }
</section>
