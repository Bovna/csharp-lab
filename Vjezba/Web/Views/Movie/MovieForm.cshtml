@model Vjezba.Web.ViewModels.MovieFormViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
    var releaseDateName = Html.NameFor(m => m.ReleaseDate).ToString();
    var releaseDateValue = Model.ReleaseDate == default
        ? DateTime.Today.ToString("yyyy-MM-ddTHH:mm")
        : Model.ReleaseDate.ToString("yyyy-MM-ddTHH:mm");
}

@if (isEdit)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ui-form"
          onsubmit="return CinemaUI.validateForm(this);">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="mb-4">
            <h5 class="ui-form__section-title">Osnovne informacije</h5>
            <div class="ui-field">
                <label asp-for="Title" class="ui-field__label">Naslov filma <span
                    style="color: var(--color-danger);">*</span></label>
                    <input asp-for="Title" class="ui-field__input" placeholder="npr. Interstellar" required />
                    <span asp-validation-for="Title" class="ui-field__validation"></span>
                </div>

                <div class="ui-field">
                    <label asp-for="Description" class="ui-field__label">Opis <span
                        style="color: var(--color-danger);">*</span></label>
                        <textarea asp-for="Description" class="ui-field__input" rows="3"
                                  placeholder="Unesite detaljan opis filma..." required></textarea>
                        <span asp-validation-for="Description" class="ui-field__validation"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="ui-form__section-title">Tehnički detalji</h5>

                    <div class="ui-field">
                        <label asp-for="Genre" class="ui-field__label">Žanr <span
                            style="color: var(--color-danger);">*</span></label>
                            <select asp-for="Genre" class="ui-field__input"
                                    asp-items="Html.GetEnumSelectList<Vjezba.Model.Entities.MovieGenre>()" aria-label="Odaberite žanr filma"
                                    required></select>
                            <span asp-validation-for="Genre" class="ui-field__validation"></span>
                        </div>

                        <div class="ui-field">
                            <label asp-for="DurationMinutes" class="ui-field__label">Trajanje (min) <span
                                style="color: var(--color-danger);">*</span></label>
                                <input asp-for="DurationMinutes" class="ui-field__input" type="number" placeholder="npr. 169" required />
                                <span asp-validation-for="DurationMinutes" class="ui-field__validation"></span>
                            </div>

                            <div class="ui-field">
                                <label asp-for="ReleaseDate" class="ui-field__label">Datum izlaska <span
                                    style="color: var(--color-danger);">*</span></label>
                                    @await Html.PartialAsync("_DatePicker", new ViewDataDictionary(ViewData) { { "Name", releaseDateName }, {
     "Value", releaseDateValue }, { "Type", "datetime-local" } })
                                    <span asp-validation-for="ReleaseDate" class="ui-field__validation"></span>
                                </div>

                                <div class="ui-field">
                                    <label asp-for="Language" class="ui-field__label">Jezik <span
                                        style="color: var(--color-danger);">*</span></label>
                                        <input asp-for="Language" class="ui-field__input" placeholder="npr. Hrvatski" required />
                                        <span asp-validation-for="Language" class="ui-field__validation"></span>
                                    </div>

                                    <div class="ui-field">
                                        <label asp-for="AgeRating" class="ui-field__label">Dobna oznaka <span
                                            style="color: var(--color-danger);">*</span></label>
                                            <input asp-for="AgeRating" class="ui-field__input" placeholder="npr. PG-13" required />
                                            <span asp-validation-for="AgeRating" class="ui-field__validation"></span>
                                        </div>
                                    </div>

                                    <div class="ui-actions ui-actions--end mt-3 pt-3 border-top">
                                        <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
                                        <a asp-action="Details" asp-route-id="@Model.Id" class="ui-btn ui-btn--secondary">Odustani</a>
                                    </div>
                                </form>
                            }
else
                            {
                                <form asp-action="Create" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
                                    @Html.AntiForgeryToken()
                                    <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

                                    <div class="mb-4">
                                        <h5 class="ui-form__section-title">Osnovne informacije</h5>
                                        <div class="ui-field">
                                            <label asp-for="Title" class="ui-field__label">Naslov filma <span
                                                style="color: var(--color-danger);">*</span></label>
                                                <input asp-for="Title" class="ui-field__input" placeholder="npr. Interstellar" required />
                                                <span asp-validation-for="Title" class="ui-field__validation"></span>
                                            </div>

                                            <div class="ui-field">
                                                <label asp-for="Description" class="ui-field__label">Opis <span
                                                    style="color: var(--color-danger);">*</span></label>
                                                    <textarea asp-for="Description" class="ui-field__input" rows="3"
                                                              placeholder="Unesite detaljan opis filma..." required></textarea>
                                                    <span asp-validation-for="Description" class="ui-field__validation"></span>
                                                </div>
                                            </div>

                                            <div class="mb-4">
                                                <h5 class="ui-form__section-title">Tehnički detalji</h5>

                                                <div class="ui-field">
                                                    <label asp-for="Genre" class="ui-field__label">Žanr <span
                                                        style="color: var(--color-danger);">*</span></label>
                                                        <select asp-for="Genre" class="ui-field__input"
                                                                asp-items="Html.GetEnumSelectList<Vjezba.Model.Entities.MovieGenre>()" aria-label="Odaberite žanr filma"
                                                                required></select>
                                                        <span asp-validation-for="Genre" class="ui-field__validation"></span>
                                                    </div>

                                                    <div class="ui-field">
                                                        <label asp-for="DurationMinutes" class="ui-field__label">Trajanje (min) <span
                                                            style="color: var(--color-danger);">*</span></label>
                                                            <input asp-for="DurationMinutes" class="ui-field__input" type="number" placeholder="npr. 169" required />
                                                            <span asp-validation-for="DurationMinutes" class="ui-field__validation"></span>
                                                        </div>

                                                        <div class="ui-field">
                                                            <label asp-for="ReleaseDate" class="ui-field__label">Datum izlaska <span
                                                                style="color: var(--color-danger);">*</span></label>
                                                                @await Html.PartialAsync("_DatePicker", new ViewDataDictionary(ViewData) { { "Name", releaseDateName }, {
      "Value", releaseDateValue }, { "Type", "datetime-local" } })
                                                                <span asp-validation-for="ReleaseDate" class="ui-field__validation"></span>
                                                            </div>

                                                            <div class="ui-field">
                                                                <label asp-for="Language" class="ui-field__label">Jezik <span
                                                                    style="color: var(--color-danger);">*</span></label>
                                                                    <input asp-for="Language" class="ui-field__input" placeholder="npr. Hrvatski" required />
                                                                    <span asp-validation-for="Language" class="ui-field__validation"></span>
                                                                </div>

                                                                <div class="ui-field">
                                                                    <label asp-for="AgeRating" class="ui-field__label">Dobna oznaka <span
                                                                        style="color: var(--color-danger);">*</span></label>
                                                                        <input asp-for="AgeRating" class="ui-field__input" placeholder="npr. PG-13" required />
                                                                        <span asp-validation-for="AgeRating" class="ui-field__validation"></span>
                                                                    </div>
                                                                </div>

                                                                <div class="ui-actions ui-actions--end mt-3 pt-3 border-top">
                                                                    <a asp-action="Index" class="ui-btn ui-btn--secondary">Odustani</a>
                                                                    <button type="submit" class="ui-btn ui-btn--primary">Spremi film</button>
                                                                </div>
                                                            </form>
                                                        }