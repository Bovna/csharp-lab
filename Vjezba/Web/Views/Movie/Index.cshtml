@model List<Vjezba.Model.Entities.Movie>

@{
    ViewData["Title"] = "Filmovi";
    var selectedLanguage = ViewBag.SelectedLanguage as string;
    var search = ViewBag.Search as string;
}

<div class="container py-4 animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
        <div>
            <h1 class="h3 mb-1" style="color: var(--color-accent); letter-spacing: 1px; text-transform: uppercase;">
                Popis filmova</h1>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-action="Create" class="ui-btn ui-btn--primary">+ Dodaj novi film</a>
            }
        </div>

        <div class="cinema-card animate-fade-in-up mb-4" style="animation-delay: 0.05s;">
            <div class="cinema-card-header">Pretraživanje</div>
            <div class="cinema-card-body">
                <form asp-action="Search" method="get" class="ui-form entity-index-search"
                      data-ajax-search-form data-ajax-results-target="#movie-index-results">
                    <div class="row g-4 align-items-end">
                        <div class="col-12 col-lg-7">
                            <div class="ui-field mb-0">
                                <label for="movieSearch" class="ui-field__label">Naziv filma</label>
                                <input id="movieSearch" name="query" value="@search" class="ui-field__input" type="search"
                                       placeholder="Pretražite po naslovu..." autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="ui-field mb-0">
                                <label for="language" class="ui-field__label">Jezik</label>
                                <select id="language" name="language" class="ui-field__input">
                                    <option value="">Svi jezici</option>
                                    @if (ViewBag.Languages != null)
                                    {
                                        foreach (var lang in ViewBag.Languages as List<string> ?? new List<string>())
                                        {
                                            if (string.Equals(selectedLanguage, lang, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@lang" selected="selected">@lang</option>
                                            }
                                            else
                                            {
                                                <option value="@lang">@lang</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="movie-index-results" data-ajax-search-results-container>
            @await Html.PartialAsync("_IndexResults", Model)
        </div>
    </div>
