@model List<Vjezba.Model.Entities.Customer>

@{
    ViewData["Title"] = "Kupci";
    bool? selectedLoyaltyMember = ViewBag.SelectedLoyaltyMember as bool?;
    var search = ViewBag.Search as string;
}

<div class="py-4 animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
        <div>
            <h1 class="h3 mb-1" style="color: var(--color-accent); letter-spacing: 1px; text-transform: uppercase;">Popis kupaca</h1>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="ui-btn ui-btn--primary">+ Dodaj novog kupca</a>
        }
    </div>

    <div class="cinema-card animate-fade-in-up mb-4" style="animation-delay: 0.05s;">
        <div class="cinema-card-header">Pretrazivanje</div>
        <div class="cinema-card-body">
            <form asp-action="Search" method="get" class="ui-form entity-index-search"
                  data-ajax-search-form data-ajax-results-target="#customer-index-results">
                <div class="row g-4 align-items-end">
                    <div class="col-12 col-lg-7">
                        <div class="ui-field mb-0">
                            <label for="customerSearch" class="ui-field__label">Ime, prezime, grad ili e-posta</label>
                            <input id="customerSearch" name="query" value="@search" class="ui-field__input" type="search"
                                   placeholder="Pretrazite kupce..." autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-5">
                        <fieldset class="ui-field mb-0">
                            <legend class="ui-field__label">Program vjernosti</legend>
                            <div class="ui-choice-group">
                                <label class="ui-choice-group__item">
                                    <input type="radio" name="loyaltyMember" value="" @(selectedLoyaltyMember.HasValue ? null : "checked") />
                                    <span>Svejedno</span>
                                </label>
                                <label class="ui-choice-group__item">
                                    <input type="radio" name="loyaltyMember" value="true" @(selectedLoyaltyMember == true ? "checked" : null) />
                                    <span>Clan</span>
                                </label>
                                <label class="ui-choice-group__item">
                                    <input type="radio" name="loyaltyMember" value="false" @(selectedLoyaltyMember == false ? "checked" : null) />
                                    <span>Nije clan</span>
                                </label>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="customer-index-results" data-ajax-search-results-container>
        @await Html.PartialAsync("_IndexResults", Model)
    </div>
</div>
