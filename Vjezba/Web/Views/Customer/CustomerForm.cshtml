@model Vjezba.Web.ViewModels.CustomerFormViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
    var registeredAtName = Html.NameFor(m => m.RegisteredAt).ToString();
    var registeredAtValue = Model.RegisteredAt == default
        ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        : Model.RegisteredAt.ToString("yyyy-MM-ddTHH:mm");
}

@if (isEdit)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="FirstName" class="ui-field__label">Ime <span style="color: var(--color-danger);">*</span></label><input asp-for="FirstName" class="ui-field__input" required /><span asp-validation-for="FirstName" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="LastName" class="ui-field__label">Prezime <span style="color: var(--color-danger);">*</span></label><input asp-for="LastName" class="ui-field__input" required /><span asp-validation-for="LastName" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="City" class="ui-field__label">Grad <span style="color: var(--color-danger);">*</span></label><input asp-for="City" class="ui-field__input" required /><span asp-validation-for="City" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="Street" class="ui-field__label">Ulica <span style="color: var(--color-danger);">*</span></label><input asp-for="Street" class="ui-field__input" required /><span asp-validation-for="Street" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="HouseNumber" class="ui-field__label">Kućni broj <span style="color: var(--color-danger);">*</span></label><input asp-for="HouseNumber" class="ui-field__input" required /><span asp-validation-for="HouseNumber" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="PostalCode" class="ui-field__label">Poštanski broj <span style="color: var(--color-danger);">*</span></label><input asp-for="PostalCode" class="ui-field__input" required /><span asp-validation-for="PostalCode" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="Email" class="ui-field__label">E-pošta <span style="color: var(--color-danger);">*</span></label><input asp-for="Email" class="ui-field__input" type="email" required /><span asp-validation-for="Email" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="Phone" class="ui-field__label">Telefon <span style="color: var(--color-danger);">*</span></label><input asp-for="Phone" class="ui-field__input" required /><span asp-validation-for="Phone" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field">
                    <label asp-for="RegisteredAt" class="ui-field__label">Datum registracije <span style="color: var(--color-danger);">*</span></label>
                    @await Html.PartialAsync("_DatePicker", new ViewDataDictionary(ViewData) { { "Name", registeredAtName }, { "Value", registeredAtValue }, { "Type", "datetime-local" } })
                    <span asp-validation-for="RegisteredAt" class="ui-field__validation"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ui-field"><label asp-for="LoyaltyPoints" class="ui-field__label">Bodovi vjernosti <span style="color: var(--color-danger);">*</span></label><input asp-for="LoyaltyPoints" class="ui-field__input" type="number" min="0" data-msg-min="Broj loyalty bodova ne može biti negativan." oninvalid="this.setCustomValidity(this.validity.rangeUnderflow ? 'Broj loyalty bodova ne može biti negativan.' : 'Bodovi vjernosti su obavezni.')" oninput="this.setCustomValidity('')" required /><span asp-validation-for="LoyaltyPoints" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="ui-field">
                    <label class="ui-field__label">&nbsp;</label>
                    <label class="d-flex align-items-center gap-2"><input asp-for="IsLoyaltyMember" type="checkbox" /><span>Član programa vjernosti</span></label>
                </div>
            </div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ui-btn ui-btn--secondary">Odustani</a>
        </div>
    </form>
}
else
{
    <form asp-action="Create" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="FirstName" class="ui-field__label">Ime <span style="color: var(--color-danger);">*</span></label><input asp-for="FirstName" class="ui-field__input" required /><span asp-validation-for="FirstName" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="LastName" class="ui-field__label">Prezime <span style="color: var(--color-danger);">*</span></label><input asp-for="LastName" class="ui-field__input" required /><span asp-validation-for="LastName" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="City" class="ui-field__label">Grad <span style="color: var(--color-danger);">*</span></label><input asp-for="City" class="ui-field__input" required /><span asp-validation-for="City" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="Street" class="ui-field__label">Ulica <span style="color: var(--color-danger);">*</span></label><input asp-for="Street" class="ui-field__input" required /><span asp-validation-for="Street" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="HouseNumber" class="ui-field__label">Kućni broj <span style="color: var(--color-danger);">*</span></label><input asp-for="HouseNumber" class="ui-field__input" required /><span asp-validation-for="HouseNumber" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="PostalCode" class="ui-field__label">Poštanski broj <span style="color: var(--color-danger);">*</span></label><input asp-for="PostalCode" class="ui-field__input" required /><span asp-validation-for="PostalCode" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="Email" class="ui-field__label">E-pošta <span style="color: var(--color-danger);">*</span></label><input asp-for="Email" class="ui-field__input" type="email" required /><span asp-validation-for="Email" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field"><label asp-for="Phone" class="ui-field__label">Telefon <span style="color: var(--color-danger);">*</span></label><input asp-for="Phone" class="ui-field__input" required /><span asp-validation-for="Phone" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-6">
                <div class="ui-field">
                    <label asp-for="RegisteredAt" class="ui-field__label">Datum registracije <span style="color: var(--color-danger);">*</span></label>
                    @await Html.PartialAsync("_DatePicker", new ViewDataDictionary(ViewData) { { "Name", registeredAtName }, { "Value", registeredAtValue }, { "Type", "datetime-local" } })
                    <span asp-validation-for="RegisteredAt" class="ui-field__validation"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ui-field"><label asp-for="LoyaltyPoints" class="ui-field__label">Bodovi vjernosti <span style="color: var(--color-danger);">*</span></label><input asp-for="LoyaltyPoints" class="ui-field__input" type="number" min="0" data-msg-min="Broj loyalty bodova ne može biti negativan." oninvalid="this.setCustomValidity(this.validity.rangeUnderflow ? 'Broj loyalty bodova ne može biti negativan.' : 'Bodovi vjernosti su obavezni.')" oninput="this.setCustomValidity('')" required /><span asp-validation-for="LoyaltyPoints" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="ui-field">
                    <label class="ui-field__label">&nbsp;</label>
                    <label class="d-flex align-items-center gap-2"><input asp-for="IsLoyaltyMember" type="checkbox" /><span>Član programa vjernosti</span></label>
                </div>
            </div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <a asp-action="Index" class="ui-btn ui-btn--secondary">Odustani</a>
            <button type="submit" class="ui-btn ui-btn--primary">Spremi kupca</button>
        </div>
    </form>
}
