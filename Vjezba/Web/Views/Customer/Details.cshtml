@model Vjezba.Web.ViewModels.CustomerDetailsViewModel

@{
    ViewData["Title"] = "Detalji kupca";
}

<div class="container py-4 animate-fade-in-up">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                <h1 class="h3 mb-0" style="color: var(--color-accent); letter-spacing: 1px; text-transform: uppercase;">
                    @Model.Customer.FirstName @Model.Customer.LastName</h1>
                    <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
                </div>

                <div class="cinema-card mb-4 animate-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="cinema-card-header">Detalji kupca</div>
                    <div class="cinema-card-body">
                        <dl class="cinema-details-list">
                            <dt>ID</dt>
                            <dd>@Model.Customer.Id</dd>

                            <dt>Ime</dt>
                            <dd>@Model.Customer.FirstName</dd>

                            <dt>Prezime</dt>
                            <dd>@Model.Customer.LastName</dd>

                            <dt>Grad</dt>
                            <dd>@Model.Customer.City</dd>

                            <dt>Adresa</dt>
                            <dd>@Model.Customer.Street @Model.Customer.HouseNumber, @Model.Customer.PostalCode</dd>

                            <dt>E-pošta</dt>
                            <dd>@Model.Customer.Email</dd>

                            <dt>Telefon</dt>
                            <dd>@Model.Customer.Phone</dd>

                            <dt>Datum registracije</dt>
                            <dd>@Model.Customer.RegisteredAt.ToString("dd.MM.yyyy")</dd>

                            <dt>Član programa vjernosti</dt>
                            <dd>@(Model.Customer.IsLoyaltyMember ? "Da" : "Ne")</dd>

                            <dt>Bodovi programa vjernosti</dt>
                            <dd>@Model.Customer.LoyaltyPoints</dd>
                        </dl>

                        <div class="ui-actions ui-actions--center ui-actions--stack-mobile"
                             style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
                            <a asp-action="Edit" asp-route-id="@Model.Customer.Id" class="ui-btn ui-btn--primary"
                               style="width: 120px; display: inline-flex; justify-content: center; align-items: center; box-sizing: border-box;">Uredi</a>

                            <form asp-action="Delete" asp-route-id="@Model.Customer.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ui-btn ui-btn--danger"
                                        style="width: 120px; padding: 0.72rem 1.2rem; display: inline-flex; justify-content: center; align-items: center; box-sizing: border-box; line-height: 1.2;"
                                        onclick="return handleDeleteClick(event, 'Jeste li sigurni da želite obrisati ovog kupca?');">Obriši</button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>

            <script>
                        function handleDeleteClick(event, message) {
                            event.preventDefault();
                            CinemaUI.showConfirm({
                                title: 'Potvrda brisanja',
                                body: message,
                                onConfirm: () => event.target.form.submit()
                            });
                        }
            </script>
        </div>
