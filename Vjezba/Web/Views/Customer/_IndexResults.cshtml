@model List<Vjezba.Model.Entities.Customer>

<div class="cinema-card">
    <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
        <table class="ui-table entity-index-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ime</th>
                    <th>Prezime</th>
                    <th>Grad</th>
                    <th>E-pošta</th>
                    <th>Registriran</th>
                    <th>Vjernost</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var customer in Model)
                    {
                        <tr>
                            <td class="text-muted">@customer.Id</td>
                            <td>@customer.FirstName</td>
                            <td>@customer.LastName</td>
                            <td>@customer.City</td>
                            <td>@customer.Email</td>
                            <td>@customer.RegisteredAt.ToString("dd.MM.yyyy")</td>
                            <td>@(customer.IsLoyaltyMember ? $"Da ({customer.LoyaltyPoints})" : "Ne")</td>
                            <td class="ui-table__actions"><a asp-action="Details" asp-route-id="@customer.Id" class="ui-btn ui-btn--primary">Detalji</a></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Nema rezultata pretrage.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>