@model Vjezba.Web.ViewModels.GlobalSearchPageViewModel

@{
    ViewData["Title"] = "Rezultati pretrage";
}

<section class="global-search-page animate-fade-in-up">
    <header class="global-search-page__header">
        <div>
            <p class="global-search-page__eyebrow">Globalna pretraga</p>
            <h1>Rezultati pretrage</h1>
            <p class="global-search-page__summary">
                Upišite najmanje @Model.MinQueryLength znaka. Rezultati se osvježavaju tijekom pisanja.
            </p>
        </div>
        <form class="global-search-page__form" asp-controller="GlobalSearch" asp-action="Results" method="get"
              data-ajax-search-form data-ajax-results-target="#global-search-page-results" data-ajax-sync-url="true">
            <label class="visually-hidden" for="globalSearchPageInput">Pojam pretrage</label>
            <input id="globalSearchPageInput" class="ui-field__input" name="query" type="search"
                   value="@Model.Query" placeholder="Upišite pojam pretrage..." autocomplete="off" />
        </form>
    </header>

    <div id="global-search-page-results" data-ajax-search-results-container>
        @await Html.PartialAsync("_ResultsContent", Model)
    </div>
</section>
