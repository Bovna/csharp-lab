@{
    ViewData["Title"] = "Početna";
}

<div class="home-page">
    <section class="home-hero animate-fade-in-up" data-home-hero>
        <div class="home-hero__content">
            <h1 class="hero-title">Vrhunsko filmsko iskustvo uz jednostavnu i brzu kupnju</h1>
            <p class="hero-subtitle">Ovdje je fokus na najboljim hitovima i kupnji koja ide brzo, jasno i bez dodatnih
                koraka.</p>
                <div class="hero-actions ui-actions ui-actions--stack-mobile">
                    <a class="ui-btn ui-btn--primary hero-actions__primary" asp-controller="TicketBuilder"
                       asp-action="Index">Kupi ulaznicu</a>
                    <a class="ui-btn ui-btn--secondary hero-actions__secondary" asp-controller="Movie"
                       asp-action="Index">Istraži filmove</a>
                </div>
            </div>
        </section>

        <section class="home-digest animate-fade-in-up">
            <div class="home-section-head">
                <div>
                    <p class="home-hero__eyebrow">Kako radi</p>
                    <h2>Tri brza koraka do večeri u kinu</h2>
                </div>
            </div>
            <div class="home-digest__grid">
                <article class="home-digest-card">
                    <span>01</span>
                    <h3>Odaberi hit</h3>
                    <p>Pregledaj najzanimljivije naslove i odmah pronađi ono što želiš gledati.</p>
                </article>
                <article class="home-digest-card">
                    <span>02</span>
                    <h3>Odaberi termin</h3>
                    <p>Jasan raspored projekcija olakšava pronalazak idealnog termina bez lutanja.</p>
                </article>
                <article class="home-digest-card">
                    <span>03</span>
                    <h3>Kupi jednostavno</h3>
                    <p>Jednostavna kupnja ulaznice vodi te ravno do potvrde, bez nepotrebnih koraka.</p>
                </article>
            </div>
        </section>
    </div>
