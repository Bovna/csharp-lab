@model Vjezba.Web.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Početna";
    var homeFeatureTones = new[]
    {
        "rgba(0, 230, 118, 0.22)",
        "rgba(35, 128, 255, 0.22)",
        "rgba(224, 90, 79, 0.22)",
        "rgba(168, 85, 247, 0.22)",
        "rgba(245, 158, 11, 0.22)"
    };
}

<div class="home-page">
    <section class="home-hero animate-fade-in-up" data-home-hero>
        <div class="home-hero__content">
            <h1 class="hero-title">Filmsko iskustvo na novoj razini</h1>
            <p class="hero-subtitle">Vaše omiljene projekcije, vrhunska udobnost i brza kupnja karata na jednom mjestu.
            </p>
            <div class="hero-actions">
                <a href="~/TicketBuilder" class="btn btn-primary btn-lg buy-ticket-btn">Kupi ulaznicu</a>
                <a href="~/filmovi" class="btn btn-lg">Svi filmovi</a>
            </div>
        </div>
    </section>

    <section class="home-featured animate-fade-in-up" data-featured-strip>
        <div class="home-section-head">
            <div>
                <h2>Trenutni hitovi</h2>
            </div>
        </div>

        <div class="home-carousel__viewport" data-carousel-viewport>
            <div class="home-carousel__track" data-carousel-track>
                @for (var index = 0; index < Model.FeaturedMovies.Count; index++)
                {
                    var movie = Model.FeaturedMovies[index];
                    var tone = homeFeatureTones[index % homeFeatureTones.Length];

                    <article class="home-feature-card @movie.ThemeClass" data-featured-card style="--home-tone: @tone;">
                        <div class="home-feature-card__poster" style="--home-tone: @tone;">
                            <span class="home-feature-card__badge">@movie.AgeRating</span>
                            <span class="home-feature-card__runtime">@movie.DurationMinutes min</span>
                            <div class="home-feature-card__poster-copy">
                                <p>@movie.GenreLabel</p>
                                <strong>@movie.Title</strong>
                            </div>
                        </div>

                        <div class="home-feature-card__body">
                            <p class="home-feature-card__meta">@movie.Language · @movie.ReleaseYear</p>
                            <h3>@movie.Title</h3>
                            <p>@movie.Description</p>
                            <div class="ui-actions ui-actions--stack-mobile">
                                <a class="ui-btn ui-btn--secondary" asp-controller="Movie" asp-action="Details"
                                   asp-route-id="@movie.Id">Detalji</a>
                                <a class="ui-btn ui-btn--primary" asp-controller="TicketBuilder" asp-action="Index">Kupi
                                    ulaznicu</a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <div class="benefits-section">
            <div class="benefit-card animate-fade-in-up" style="animation-delay: 0.1s;">
                <div class="benefit-icon">01</div>
                <h3>Najnoviji hitovi</h3>
                <p>Gledajte premijere i najpopularnije naslove na velikom platnu u najvišoj kvaliteti slike i zvuka.</p>
            </div>
            <div class="benefit-card animate-fade-in-up" style="animation-delay: 0.2s;">
                <div class="benefit-icon">02</div>
                <h3>Brza kupnja</h3>
                <p>Osigurajte svoje ulaznice i omiljena sjedala u samo nekoliko jednostavnih koraka iz udobnosti svog doma.
                </p>
            </div>
            <div class="benefit-card animate-fade-in-up" style="animation-delay: 0.3s;">
                <div class="benefit-icon">03</div>
                <h3>Premium sjedala</h3>
                <p>Odaberite savršenu poziciju u dvorani za maksimalnu udobnost tijekom cijele projekcije.</p>
            </div>
        </div>
    </div>
