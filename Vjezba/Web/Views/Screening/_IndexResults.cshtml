@model List<Vjezba.Model.Entities.Screening>

<div class="cinema-card animate-fade-in-up" data-ajax-search-results>
    <div class="cinema-card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <span>Rezultati</span>
        <span class="cinema-badge">Prikazano: @Model.Count</span>
    </div>
    <div class="cinema-card-body p-0">
        <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
            <table class="ui-table entity-index-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Film</th>
                        <th>Kino</th>
                        <th>Dvorana</th>
                        <th>Početak</th>
                        <th>Završetak</th>
                        <th>3D projekcija</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var screening in Model)
                        {
                            <tr>
                                <td class="text-muted">@screening.Id</td>
                                <td>@(screening.Movie?.Title ?? "-")</td>
                                <td>@(screening.Hall?.Cinema?.Name ?? "-")</td>
                                <td>@(screening.Hall?.Name ?? "-")</td>
                                <td>@screening.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@screening.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (screening.Is3D)
                                    {
                                        <span class="cinema-status-yes">Da</span>
                                    }
                                    else
                                    {
                                        <span class="cinema-status-no">Ne</span>
                                    }
                                </td>
                                <td class="ui-table__actions">
                                    <a asp-action="Details" asp-route-id="@screening.Id" class="ui-btn ui-btn--primary"
                                       style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">Detalji</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-muted text-center py-4">Nema projekcija koje odgovaraju pretrazi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>