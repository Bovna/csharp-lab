@model List<Vjezba.Model.Entities.Screening>

<section class="schedule" data-ajax-search-results aria-live="polite">
    <p class="schedule__summary">Prikazano projekcija: @Model.Count</p>
    @if (Model.Any())
    {
        @foreach (var day in Model.OrderBy(s => s.StartTime).GroupBy(s => s.StartTime.Date))
        {
            <section class="schedule__day" aria-labelledby="schedule-@day.Key.ToString("yyyyMMdd")">
                <h2 id="schedule-@day.Key.ToString("yyyyMMdd")">@day.Key.ToString("dddd, dd. MMMM", new System.Globalization.CultureInfo("hr-HR"))</h2>
                <div class="schedule__list">
                    @foreach (var screening in day)
                    {
                        <article class="schedule__item">
                            <time class="schedule__time" datetime="@screening.StartTime.ToString("O")">@screening.StartTime.ToString("HH:mm")</time>
                            <div class="schedule__content"><h3>@screening.Movie.Title</h3><p>@screening.Hall.Cinema.Name · @screening.Hall.Name</p><span>@(screening.Is3D ? "3D" : "2D")</span></div>
                            <div class="ui-actions ui-actions--stack-mobile"><a class="ui-btn ui-btn--primary" asp-controller="TicketBuilder" asp-action="Seats" asp-route-cinemaId="@screening.Hall.CinemaId" asp-route-movieId="@screening.MovieId" asp-route-screeningId="@screening.Id">Odaberi sjedala</a>@if (User.Identity?.IsAuthenticated == true) { <a class="ui-btn ui-btn--secondary" asp-action="Details" asp-route-id="@screening.Id">Detalji</a> }</div>
                        </article>
                    }
                </div>
            </section>
        }
    }
    else { <div class="ui-empty-state">Nema dostupnih projekcija za odabrane filtre.</div> }
</section>
