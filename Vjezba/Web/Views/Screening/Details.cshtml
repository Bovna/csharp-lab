@model Vjezba.Web.ViewModels.ScreeningDetailsViewModel

@{
    ViewData["Title"] = "Detalji projekcije";
    var soldTickets = Model.Tickets.Count;
    var revenue = Model.Tickets.Sum(t => t.Price);
    var hallCapacity = Model.Screening.Hall?.Capacity ?? 0;
    var availableSeats = Math.Max(hallCapacity - soldTickets, 0);
    var occupancyPercent = hallCapacity > 0 ? Math.Min(100m, Math.Round((decimal)soldTickets / hallCapacity * 100m, 1)) :
0m;
}

<div class="container py-4 animate-fade-in-up entity-details-page">
    <section class="entity-hero entity-hero--timeline">
        <div class="entity-hero__content">
            <p class="entity-hero__eyebrow">Projekcija</p>
            <h1 class="entity-hero__title">@(Model.Screening.Movie?.Title ?? "Projekcija")</h1>
            <p class="entity-hero__subtitle">@Model.Screening.StartTime.ToString("dd.MM.yyyy HH:mm") •
                @(Model.Screening.Hall?.Cinema?.Name ?? "-") / @(Model.Screening.Hall?.Name ?? "-")</p>
                <ol class="screening-timeline">
                    <li>
                        <span class="screening-timeline__label">Ulaz publike</span>
                        <strong>@Model.Screening.StartTime.AddMinutes(-20).ToString("HH:mm")</strong>
                    </li>
                    <li>
                        <span class="screening-timeline__label">Početak filma</span>
                        <strong>@Model.Screening.StartTime.ToString("HH:mm")</strong>
                    </li>
                    <li>
                        <span class="screening-timeline__label">Kraj filma</span>
                        <strong>@Model.Screening.EndTime.ToString("HH:mm")</strong>
                    </li>
                </ol>
            </div>
            <div class="ui-actions ui-actions--stack-mobile">
                <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
            </div>
        </section>

        <section class="entity-kpi-grid">
            <article class="entity-kpi">
                <p class="entity-kpi__label">Prodane ulaznice</p>
                <p class="entity-kpi__value entity-kpi__value--accent">@soldTickets</p>
            </article>
            <article class="entity-kpi">
                <p class="entity-kpi__label">Prihod</p>
                <p class="entity-kpi__value">@revenue.ToString("0.00") EUR</p>
            </article>
            <article class="entity-kpi">
                <p class="entity-kpi__label">Trajanje</p>
                <p class="entity-kpi__value">@((Model.Screening.EndTime -
                                                                            Model.Screening.StartTime).TotalMinutes.ToString("0")) min</p>
                </article>
                <article class="entity-kpi">
                    <p class="entity-kpi__label">Format</p>
                    <p class="entity-kpi__value">@(Model.Screening.Is3D ? "3D" : "2D")</p>
                </article>
            </section>

            <article class="cinema-card occupancy-board">
                <div class="cinema-card-header">Popunjenost dvorane</div>
                <div class="cinema-card-body">
                    <div class="occupancy-board__top">
                        <p class="occupancy-board__value">@occupancyPercent.ToString("0.#")%</p>
                        <p class="occupancy-board__meta">@soldTickets / @hallCapacity mjesta zauzeto</p>
                    </div>
                    <div class="occupancy-meter" role="img" aria-label="Popunjenost @occupancyPercent%">
                        <span class="occupancy-meter__fill" style="width: @occupancyPercent%;"></span>
                    </div>
                    <div class="occupancy-board__legend">
                        <span class="entity-pill entity-pill--success">Slobodno: @availableSeats</span>
                        <span class="entity-pill">Prodano: @soldTickets</span>
                    </div>
                </div>
            </article>

            <div class="entity-details-grid">
                <article class="cinema-card entity-details-panel">
                    <div class="cinema-card-header">Detalji projekcije</div>
                    <div class="cinema-card-body">
                        <dl class="cinema-details-list">
                            <dt>ID</dt>
                            <dd>@Model.Screening.Id</dd>

                            <dt>Film</dt>
                            <dd>@(Model.Screening.Movie?.Title ?? "-")</dd>

                            <dt>Kino</dt>
                            <dd>@(Model.Screening.Hall?.Cinema?.Name ?? "-")</dd>

                            <dt>Dvorana</dt>
                            <dd>@(Model.Screening.Hall?.Name ?? "-")</dd>

                            <dt>Početak</dt>
                            <dd>@Model.Screening.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

                            <dt>Završetak</dt>
                            <dd>@Model.Screening.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>
                        </dl>

                        <div class="ui-actions ui-actions--center ui-actions--stack-mobile entity-actions">
                            <a asp-action="Edit" asp-route-id="@Model.Screening.Id" class="ui-btn ui-btn--primary">Uredi</a>
                            <form asp-action="Delete" asp-route-id="@Model.Screening.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ui-btn ui-btn--danger"
                                        onclick="return handleDeleteScreening(event);">Obriši</button>
                            </form>
                        </div>
                    </div>
                </article>

                <article class="cinema-card entity-details-panel">
                    <div class="cinema-card-header">Povezano</div>
                    <div class="cinema-card-body">
                        <div class="entity-meta">
                            <span class="entity-pill @(Model.Screening.Is3D ? "entity-pill--success" : "entity-pill--muted")">
                                @(Model.Screening.Is3D ? "3D projekcija" : "2D projekcija")
                            </span>
                            <span class="entity-pill">@soldTickets ulaznica</span>
                        </div>
                        <ul class="entity-link-list">
                            @if (Model.Screening.Movie is not null)
                            {
                                <li><a asp-controller="Movie" asp-action="Details" asp-route-id="@Model.Screening.Movie.Id">Detalji
                                    filma</a></li>
                                }
                                @if (Model.Screening.Hall is not null)
                                {
                                    <li><a asp-controller="Hall" asp-action="Details" asp-route-id="@Model.Screening.Hall.Id">Detalji
                                        dvorane</a></li>
                                    }
                                    <li><a asp-controller="TicketBuilder" asp-action="Index">Pokrenite brzu kupnju</a></li>
                                </ul>
                            </div>
                        </article>
                    </div>

                    <article class="cinema-card animate-fade-in-up">
                        <div class="cinema-card-header">Ulaznice za projekciju</div>
                        <div class="cinema-table-wrapper">
                            @if (Model.Tickets.Any())
                            {
                                <table class="ui-table entity-related-table">
                                    <thead>
                                        <tr>
                                            <th>Broj ulaznice</th>
                                            <th>Kupac</th>
                                            <th>Sjedalo</th>
                                            <th>Kupnja</th>
                                            <th>Cijena</th>
                                            <th>Status</th>
                                            <th>Akcija</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in Model.Tickets)
                                        {
                                            <tr>
                                                <td>@ticket.TicketNumber</td>
                                                <td>@(ticket.Customer is null ? "-" : $"{ticket.Customer.FirstName} {ticket.Customer.LastName}")
                                                </td>
                                                <td>@(ticket.Seat is null ? "-" : $"{ticket.Seat.RowLabel}{ticket.Seat.SeatNumber}")</td>
                                                <td>@ticket.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@ticket.Price.ToString("0.00") EUR</td>
                                                <td>@ticket.Status</td>
                                                <td><a asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id">Otvori</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="cinema-card-body">
                                    <p class="text-muted mb-0">Za ovu projekciju trenutno nema ulaznica.</p>
                                </div>
                            }
                        </div>
                    </article>
                </div>

                @section Scripts {
                    <script>
                        function handleDeleteScreening(event) {
                            event.preventDefault();
                            const form = event.currentTarget.form;

                            if (!form) {
                                return false;
                            }

                            CinemaUI.showConfirm({
                                title: 'Potvrdite brisanje',
                                body: 'Jeste li sigurni da želite trajno obrisati ovu projekciju?',
                                onConfirm: () => form.submit()
                            });
                            return false;
                        }
                    </script>
                }
