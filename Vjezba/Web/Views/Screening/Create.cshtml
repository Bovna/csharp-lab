@model Vjezba.Model.Entities.Screening

@{
    ViewData["Title"] = "Dodaj projekciju";
    var movies = ViewBag.Movies as List<Vjezba.Model.Entities.Movie> ?? new List<Vjezba.Model.Entities.Movie>();
    var halls = ViewBag.Halls as List<Vjezba.Model.Entities.Hall> ?? new List<Vjezba.Model.Entities.Hall>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 entity-form">
            <div class="cinema-card animate-fade-in-up">
                <div class="cinema-card-header">Dodaj novu projekciju</div>
                <div class="cinema-card-body">
                    <form asp-action="Create" method="post" class="ui-form"
                          onsubmit="return CinemaUI.validateForm(this);">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3"
                             style="background-color: rgba(255,0,0,0.1); border-radius: 4px;"></div>

                        <div class="mb-5">
                            <h5 class="mb-3"
                                style="color: var(--color-accent); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                Vremenske postavke</h5>
                                <div class="row g-4" style="gap:16px;">
                                    <div class="col-md-6">
                                        <div class="ui-field">
                                            <label asp-for="StartTime" class="ui-field__label">Početak <span
                                                style="color: #ef4444;">*</span></label>
                                                <input asp-for="StartTime" class="ui-field__input" type="datetime-local"
                                                       required />
                                                <span class="ui-field__validation"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="ui-field">
                                                <label asp-for="EndTime" class="ui-field__label">Završetak <span
                                                    style="color: #ef4444;">*</span></label>
                                                    <input asp-for="EndTime" class="ui-field__input" type="datetime-local"
                                                           required />
                                                    <span class="ui-field__validation"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-5">
                                        <h5 class="mb-3"
                                            style="color: var(--color-accent); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                            Osnovne informacije</h5>
                                            <div class="row g-4" style="gap:16px;">
                                                <div class="col-md-6">
                                                    <div class="ui-field">
                                                        <label asp-for="MovieId" class="ui-field__label">Film <span
                                                            style="color: #ef4444;">*</span></label>
                                                            <select asp-for="MovieId" class="ui-field__input" required>
                                                                <option value="">Odaberite film</option>
                                                                @foreach (var movie in movies)
                                                                {
                                                                    <option value="@movie.Id">@movie.Title</option>
                                                                }
                                                            </select>
                                                            <span class="ui-field__validation"></span>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="ui-field">
                                                            <label asp-for="HallId" class="ui-field__label">Dvorana <span
                                                                style="color: #ef4444;">*</span></label>
                                                                <select asp-for="HallId" class="ui-field__input" required>
                                                                    <option value="">Odaberite dvoranu</option>
                                                                    @foreach (var hall in halls)
                                                                    {
                                                                        <option value="@hall.Id">@hall.Cinema.Name - @hall.Name</option>
                                                                    }
                                                                </select>
                                                                <span class="ui-field__validation"></span>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6 d-flex align-items-end">
                                                            <div class="ui-field">
                                                                <label class="ui-field__label">&nbsp;</label>
                                                                <label class="d-flex align-items-center gap-2">
                                                                    <input asp-for="Is3D" type="checkbox" />
                                                                    <span>3D projekcija</span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="ui-actions mt-4 pt-3 border-top">
                                                    <button type="submit" class="ui-btn ui-btn--primary">Spremi projekciju</button>
                                                    <a asp-action="Index" class="ui-btn ui-btn--secondary">Odustani</a>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>