<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kino Sustav</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vjezba.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
        var canViewSensitiveNavigation = User.IsInRole("Admin") || User.IsInRole("Manager");

        var uiControllerLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Home"] = "Početna",
            ["Cinema"] = "Kina",
            ["Customer"] = "Kupci",
            ["Hall"] = "Dvorane",
            ["Movie"] = "Filmovi",
            ["Screening"] = "Projekcije",
            ["Seat"] = "Sjedala",
            ["Ticket"] = "Ulaznice",
            ["TicketBuilder"] = "Brza kupnja"
        };

        var uiActionLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Index"] = "Pregled",
            ["Details"] = "Detalji"
        };

        var ticketBuilderActionLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Index"] = "Odabir kina",
            ["Movies"] = "Odabir filma",
            ["Screenings"] = "Odabir projekcije",
            ["Seats"] = "Odabir sjedala",
            ["Checkout"] = "Plaćanje - Korak 5",
            ["Success"] = "Kupnja dovršena"
        };

        var currentControllerLabel = uiControllerLabels.TryGetValue(currentController, out var controllerLabel)
            ? controllerLabel
            : currentController;

        var currentActionLabel = uiActionLabels.TryGetValue(currentAction, out var actionLabel)
            ? actionLabel
            : currentAction;

        if (string.Equals(currentController, "TicketBuilder", StringComparison.OrdinalIgnoreCase)
            && ticketBuilderActionLabels.TryGetValue(currentAction, out var ticketBuilderActionLabel))
        {
            currentActionLabel = ticketBuilderActionLabel;
        }
    }

    <header class="site-header">
        <div class="container d-flex flex-wrap align-items-center gap-3">
            <a class="nav-brand" asp-area="" asp-controller="Home" asp-action="Index">Kino Sustav</a>
            <nav class="site-nav" aria-label="Glavna navigacija">
                <ul class="nav-menu">
                    <li><a class="nav-link @(currentController == "Movie" ? "active" : "")" asp-controller="Movie" asp-action="Index">Filmovi</a></li>
                    <li><a class="nav-link @(currentController == "Screening" ? "active" : "")" asp-controller="Screening" asp-action="Index">Projekcije</a></li>
                    <li><a class="nav-link @(currentController == "Cinema" ? "active" : "")" asp-controller="Cinema" asp-action="Index">Kina</a></li>
                    <li><a class="nav-link @(currentController == "Hall" ? "active" : "")" asp-controller="Hall" asp-action="Index">Dvorane</a></li>
                    <li><a class="nav-link @(currentController == "Seat" ? "active" : "")" asp-controller="Seat" asp-action="Index">Sjedala</a></li>
                    @if (canViewSensitiveNavigation)
                    {
                        <li><a class="nav-link @(currentController == "Customer" ? "active" : "")" asp-controller="Customer" asp-action="Index">Kupci</a></li>
                        <li><a class="nav-link @(currentController == "Ticket" ? "active" : "")" asp-controller="Ticket" asp-action="Index">Ulaznice</a></li>
                    }
                    <li><a class="nav-link @(currentController == "TicketBuilder" ? "active" : "")" asp-controller="TicketBuilder" asp-action="Index">Brza kupnja</a></li>
                </ul>
            </nav>
            <div class="site-header__auth ms-auto">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <div class="container site-main-container">
        @if (!(currentController == "Home" && currentAction == "Index"))
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index">Početna</a>
                    </li>
                    @if (!string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase))
                    {
                        if (string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@currentControllerLabel</li>
                        }
                        else
                        {
                            var customActionLabel = currentAction switch
                            {
                                "Create" => "Dodaj",
                                "Edit" => "Uredi",
                                _ => currentActionLabel
                            };

                            <li class="breadcrumb-item">
                                <a asp-area="" asp-controller="@currentController" asp-action="Index">@currentControllerLabel</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">@customActionLabel</li>
                        }
                    }
                    else
                    {
                        <li class="breadcrumb-item active" aria-current="page">@currentActionLabel</li>
                    }
                </ol>
            </nav>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 - Sustav za prodaju kino ulaznica
        </div>
    </footer>

    <div class="modal-confirm" id="modal-confirm" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="modal-confirm__backdrop"></div>
        <div class="modal-confirm__panel">
            <h2 class="modal-confirm__title">Potvrdite</h2>
            <p class="modal-confirm__body">Jeste li sigurni?</p>
            <div class="modal-confirm__actions ui-actions ui-actions--end">
                <button type="button" class="ui-btn ui-btn--secondary" data-action="cancel">Odustani</button>
                <button type="button" class="ui-btn ui-btn--primary" data-action="confirm">Potvrdi</button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ui/autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/ui/ajaxSearch.js" asp-append-version="true"></script>
    <script src="~/js/ui/datepicker.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui/ticketBuilder.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
