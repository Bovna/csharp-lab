<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KinoKlik</title>
    <link rel="icon" type="image/svg+xml" href="~/images/brand/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
        var canViewSensitiveNavigation = User.IsInRole("Admin") || User.IsInRole("Manager");
        var isManagementQuery = string.Equals(Context.Request.Query["management"], "true", StringComparison.OrdinalIgnoreCase);

        var uiControllerLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Home"] = "Početna",
            ["Cinema"] = "Kina",
            ["Customer"] = "Kupci",
            ["Hall"] = "Dvorane",
            ["Movie"] = "Na programu",
            ["Screening"] = "Raspored",
            ["Seat"] = "Sjedala",
            ["Ticket"] = "Ulaznice",
            ["TicketBuilder"] = "Kupi ulaznicu",
            ["GlobalSearch"] = "Pretraga"
        };

        var uiActionLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Index"] = "Pregled",
            ["Details"] = "Detalji",
            ["Results"] = "Pretraga"
        };

        var ticketBuilderActionLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Index"] = "Odabir kina",
            ["Movies"] = "Odabir filma",
            ["Screenings"] = "Odabir projekcije",
            ["Seats"] = "Odabir sjedala",
            ["Checkout"] = "Plaćanje - Korak 5",
            ["Success"] = "Kupnja dovršena"
        };

        var currentControllerLabel = uiControllerLabels.TryGetValue(currentController, out var controllerLabel)
            ? controllerLabel
            : currentController;

        var currentActionLabel = uiActionLabels.TryGetValue(currentAction, out var actionLabel)
            ? actionLabel
            : currentAction;

        if (string.Equals(currentController, "TicketBuilder", StringComparison.OrdinalIgnoreCase)
            && ticketBuilderActionLabels.TryGetValue(currentAction, out var ticketBuilderActionLabel))
        {
            currentActionLabel = ticketBuilderActionLabel;
        }
    }

    <header class="site-header">
        <div class="container d-flex flex-wrap align-items-center gap-3">
            <a class="nav-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="KinoKlik — početna">
                <img class="nav-brand__logo" src="~/images/brand/logo.svg" asp-append-version="true"
                     alt="" width="160" height="40" />
            </a>
            <nav class="site-nav" aria-label="Glavna navigacija">
                <ul class="nav-menu">
                    <li><a class="nav-link @(currentController == "Movie" && !isManagementQuery ? "active" : "")" asp-controller="Movie" asp-action="Index">Na programu</a></li>
                    <li><a class="nav-link @(currentController == "Screening" && !isManagementQuery ? "active" : "")" asp-controller="Screening" asp-action="Index">Raspored</a></li>
                    <li><a class="nav-link @(currentController == "Cinema" && !isManagementQuery ? "active" : "")" asp-controller="Cinema" asp-action="Index">Kina</a></li>
                    <li><a class="nav-link nav-link--cta @(currentController == "TicketBuilder" ? "active" : "")" asp-controller="TicketBuilder" asp-action="Index">Kupi ulaznicu</a></li>
                    @if (canViewSensitiveNavigation)
                    {
                        var isManagementActive =
                            ((string.Equals(currentController, "Cinema", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(currentController, "Movie", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(currentController, "Screening", StringComparison.OrdinalIgnoreCase)) && isManagementQuery)
                            || string.Equals(currentController, "Hall", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(currentController, "Seat", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(currentController, "Customer", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(currentController, "Ticket", StringComparison.OrdinalIgnoreCase);

                        <li class="nav-menu__item nav-dropdown">
                            <details class="nav-dropdown__details">
                                <summary class="nav-link nav-dropdown__trigger nav-dropdown__trigger--management @(isManagementActive ? "active" : "")">
                                    Upravljanje
                                    <span class="nav-dropdown__chevron" aria-hidden="true"></span>
                                </summary>
                                <ul class="nav-dropdown__menu" aria-label="Administrativna navigacija">
                                    <li><a class="nav-dropdown__link @(currentController == "Cinema" && isManagementQuery ? "active" : "")" asp-controller="Cinema" asp-action="Index" asp-route-management="true">Kina</a></li>
                                    <li><a class="nav-dropdown__link @(currentController == "Movie" && isManagementQuery ? "active" : "")" asp-controller="Movie" asp-action="Index" asp-route-management="true">Filmovi</a></li>
                                    <li><a class="nav-dropdown__link @(currentController == "Screening" && isManagementQuery ? "active" : "")" asp-controller="Screening" asp-action="Index" asp-route-management="true">Projekcije</a></li>
                                    <li><a class="nav-dropdown__link @(currentController == "Hall" ? "active" : "")" asp-controller="Hall" asp-action="Index">Dvorane</a></li>
                                    <li><a class="nav-dropdown__link @(currentController == "Seat" ? "active" : "")" asp-controller="Seat" asp-action="Index">Sjedala</a></li>
                                    <li><a class="nav-dropdown__link @(currentController == "Customer" ? "active" : "")" asp-controller="Customer" asp-action="Index">Kupci</a></li>
                                    <li><a class="nav-dropdown__link @(currentController == "Ticket" ? "active" : "")" asp-controller="Ticket" asp-action="Index">Ulaznice</a></li>
                                </ul>
                            </details>
                        </li>
                    }
                </ul>
            </nav>
            <form class="site-header__search global-search" role="search" method="get"
                  action="@Url.Action("Results", "GlobalSearch")" data-global-search
                  data-endpoint="@Url.Action("Index", "GlobalSearch")" data-min-length="2">
                <label class="visually-hidden" for="globalSearchInput">Globalna pretraga</label>
                <div class="global-search__combobox" role="combobox" aria-expanded="false"
                     aria-haspopup="listbox" aria-owns="globalSearchResults" data-global-search-combobox>
                    <input id="globalSearchInput" class="global-search__input" name="query" type="search"
                           placeholder="Pretraga filmova, kina, projekcija..." autocomplete="off"
                           aria-autocomplete="list" aria-controls="globalSearchResults" aria-expanded="false"
                           data-global-search-input />
                    <button class="global-search__submit" type="submit" aria-label="Prikaži rezultate pretrage">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" />
                        </svg>
                    </button>
                    <div id="globalSearchResults" class="global-search__panel" role="listbox"
                         data-global-search-results hidden></div>
                </div>
                <div class="visually-hidden" aria-live="polite" data-global-search-status></div>
            </form>
            <div class="site-header__auth ms-auto">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <div class="container site-main-container">
        @if (!(currentController == "Home" && currentAction == "Index"))
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index">Početna</a>
                    </li>
                    @if (!string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase))
                    {
                        if (string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@currentControllerLabel</li>
                        }
                        else if (string.Equals(currentController, "GlobalSearch", StringComparison.OrdinalIgnoreCase)
                            && string.Equals(currentAction, "Results", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@currentControllerLabel</li>
                        }
                        else
                        {
                            var customActionLabel = currentAction switch
                            {
                                "Create" => "Dodaj",
                                "Edit" => "Uredi",
                                _ => currentActionLabel
                            };

                            <li class="breadcrumb-item">
                                <a asp-area="" asp-controller="@currentController" asp-action="Index">@currentControllerLabel</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">@customActionLabel</li>
                        }
                    }
                    else
                    {
                        <li class="breadcrumb-item active" aria-current="page">@currentActionLabel</li>
                    }
                </ol>
            </nav>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container site-footer__content">
            <p class="site-footer__copy">&copy; 2026 KinoKlik - Online kupnja kino ulaznica</p>
        </div>
    </footer>

    <div class="modal-confirm" id="modal-confirm" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="modal-confirm__backdrop"></div>
        <div class="modal-confirm__panel">
            <h2 class="modal-confirm__title">Potvrdite</h2>
            <p class="modal-confirm__body">Jeste li sigurni?</p>
            <div class="modal-confirm__actions ui-actions ui-actions--end">
                <button type="button" class="ui-btn ui-btn--secondary" data-action="cancel">Odustani</button>
                <button type="button" class="ui-btn ui-btn--primary" data-action="confirm">Potvrdi</button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ui/autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/ui/globalSearch.js" asp-append-version="true"></script>
    <script src="~/js/ui/ajaxSearch.js" asp-append-version="true"></script>
    <script src="~/js/ui/datepicker.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui/ticketBuilder.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
