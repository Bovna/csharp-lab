@model ErrorViewModel
@{
    ViewData["Title"] = "Greška";
}

<h1 class="text-danger">Došlo je do greške.</h1>
<h2 class="text-danger">Zahtjev nije bilo moguće obraditi.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (Model.ShowOperationId)
{
    <p>
        <strong>Operation ID:</strong> <code>@Model.OperationId</code>
    </p>
}
