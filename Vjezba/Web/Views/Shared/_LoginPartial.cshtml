@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager

<nav class="site-auth" aria-label="Korisnički izbornik">
    <ul class="site-auth__links">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentRoles = new List<string>();
        if (User.IsInRole("Admin"))
        {
            currentRoles.Add("Admin");
        }

        if (User.IsInRole("Manager"))
        {
            currentRoles.Add("Manager");
        }

        <li class="site-auth__item site-auth__item--meta">
            <span class="site-auth__label">Prijavljen si kao</span>
            <strong class="site-auth__name">@User.Identity?.Name</strong>
            <span class="site-auth__label">Rola: @(currentRoles.Any() ? string.Join(", ", currentRoles) : "Bez role")</span>
        </li>
        <li class="site-auth__item">
            <form class="site-auth__form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="ui-btn ui-btn--primary site-auth__button">Odjava</button>
            </form>
        </li>
    }
    else
    {
        <li class="site-auth__item">
            <a class="ui-btn ui-btn--primary site-auth__button" asp-area="Identity" asp-page="/Account/Login">Prijava</a>
        </li>
    }
    </ul>
</nav>
