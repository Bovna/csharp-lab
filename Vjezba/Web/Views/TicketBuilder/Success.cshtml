@model Vjezba.Web.ViewModels.TicketBuilderPurchaseSuccessViewModel
@{
    ViewData["Title"] = "Brza kupnja - Uspjeh";
}

<div class="tb-cinema tb-page tb-page-success" data-ticket-builder-page data-current-step="5">
    <div class="tb-header">
        <h1>Kupnja je dovrsena</h1>
        <p>Ulaznica je spremljena, a novi kupac je dodan u bazu podataka.</p>
    </div>

    <div class="tb-success-panel tb-checkout-panel">
        <div class="tb-success-ticket">
            <span class="tb-live-ticket__eyebrow">Broj ulaznice</span>
            <strong>@Model.TicketNumber</strong>
        </div>

        <div class="tb-checkout-summary">
            <dl>
                <dt>Kupac</dt>
                <dd>@Model.CustomerName</dd>
            </dl>
            <dl>
                <dt>E-posta</dt>
                <dd>@Model.CustomerEmail</dd>
            </dl>
            <dl>
                <dt>Kino</dt>
                <dd>@Model.CinemaName</dd>
            </dl>
            <dl>
                <dt>Film</dt>
                <dd>@Model.MovieTitle</dd>
            </dl>
            <dl>
                <dt>Dvorana</dt>
                <dd>@Model.HallName</dd>
            </dl>
            <dl>
                <dt>Sjedalo</dt>
                <dd>@Model.SeatLabel</dd>
            </dl>
            <dl>
                <dt>Vrijeme</dt>
                <dd>@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>
            <dl>
                <dt>Cijena</dt>
                <dd>@Model.Price.ToString("0.00") EUR</dd>
            </dl>
        </div>

        <div class="ui-actions ui-actions--end tb-checkout-actions">
            <a class="ui-btn ui-btn--secondary" asp-controller="TicketBuilder" asp-action="Index">Nova kupnja</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="ui-btn ui-btn--primary" asp-controller="Ticket" asp-action="Details" asp-route-id="@Model.TicketId">Detalji ulaznice</a>
            }
        </div>
    </div>
</div>
