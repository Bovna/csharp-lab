@model Vjezba.Web.ViewModels.TicketBuilderCheckoutViewModel
@{
    ViewData["Title"] = "Brza kupnja - Placanje";
    var hasKnownEmail = Model.IsAuthenticated && !string.IsNullOrWhiteSpace(Model.KnownEmail);
}

<div class="tb-cinema tb-page tb-page-checkout" data-ticket-builder-page data-current-step="5">
    <div class="tb-header">
        <h1>@Model.MovieTitle</h1>
        <p>Korak 5/5: unesi podatke kupca i potvrdi kupnju</p>
        <small>@Model.HallName | @Model.StartTime.ToString("dd.MM.yyyy HH:mm") @(Model.Is3D ? "| 3D" : "")</small>
    </div>

    <div class="tb-step-line" data-ticket-builder-steps data-current-step="5" aria-label="Koraci brze kupnje">
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Index">1 Kino</a>
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Movies"
           asp-route-cinemaId="@Model.CinemaId">2 Film</a>
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Screenings"
           asp-route-cinemaId="@Model.CinemaId" asp-route-movieId="@Model.MovieId">3 Projekcija</a>
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Seats"
           asp-route-cinemaId="@Model.CinemaId" asp-route-movieId="@Model.MovieId"
           asp-route-screeningId="@Model.ScreeningId">4 Sjedalo</a>
        <span class="tb-step active" aria-current="step">5 Placanje</span>
    </div>

    <div class="tb-checkout-panel">
        <div class="tb-checkout-summary">
            <dl>
                <dt>Kino</dt>
                <dd>@Model.CinemaName</dd>
            </dl>

            <dl>
                <dt>Film</dt>
                <dd>@Model.MovieTitle</dd>
            </dl>

            <dl>
                <dt>Vrijeme</dt>
                <dd>@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <dl>
                <dt>Sjedalo</dt>
                <dd>@Model.SeatLabel (@Model.SeatType)</dd>
            </dl>

            <dl>
                <dt>Cijena</dt>
                <dd><strong>@Model.Price.ToString("0.00") EUR</strong></dd>
            </dl>
        </div>

        <div class="tb-checkout-grid">
            <form asp-controller="TicketBuilder" asp-action="Purchase" method="post" class="ui-form tb-checkout-form"
                  data-ticket-checkout-form data-authenticated="@(Model.IsAuthenticated ? "true" : "false")"
                  onsubmit="return CinemaUI.validateForm(this);">
                @Html.AntiForgeryToken()
                <input asp-for="Input.CinemaId" type="hidden" />
                <input asp-for="Input.MovieId" type="hidden" />
                <input asp-for="Input.ScreeningId" type="hidden" />
                <input asp-for="Input.SeatId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

                <div class="tb-form-progress" aria-hidden="true">
                    <span data-ticket-form-progress></span>
                </div>

                <div class="tb-form-section" data-ticket-form-section>
                    <h2>Osnovni podaci</h2>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="ui-field">
                                <label asp-for="Input.FirstName" class="ui-field__label">Ime <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.FirstName" class="ui-field__input" required data-ticket-field data-ticket-live-name />
                                <span asp-validation-for="Input.FirstName" class="ui-field__validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ui-field">
                                <label asp-for="Input.LastName" class="ui-field__label">Prezime <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.LastName" class="ui-field__input" required data-ticket-field data-ticket-live-name />
                                <span asp-validation-for="Input.LastName" class="ui-field__validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ui-field">
                                <label asp-for="Input.Phone" class="ui-field__label">Telefon <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.Phone" class="ui-field__input" required data-ticket-field data-ticket-live-phone />
                                <span asp-validation-for="Input.Phone" class="ui-field__validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ui-field">
                                <label asp-for="Input.Email" class="ui-field__label">E-posta <span style="color: var(--color-danger);">*</span></label>
                                @if (hasKnownEmail)
                                {
                                    <input asp-for="Input.Email" class="ui-field__input" type="email" required readonly data-ticket-field data-ticket-live-email />
                                }
                                else
                                {
                                    <input asp-for="Input.Email" class="ui-field__input" type="email" required data-ticket-field data-ticket-live-email />
                                }
                                <span asp-validation-for="Input.Email" class="ui-field__validation"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tb-form-section" data-ticket-form-section>
                    <h2>Adresa</h2>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="ui-field">
                                <label asp-for="Input.City" class="ui-field__label">Grad <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.City" class="ui-field__input" required data-ticket-field />
                                <span asp-validation-for="Input.City" class="ui-field__validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ui-field">
                                <label asp-for="Input.PostalCode" class="ui-field__label">Postanski broj <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.PostalCode" class="ui-field__input" required data-ticket-field />
                                <span asp-validation-for="Input.PostalCode" class="ui-field__validation"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="ui-field">
                                <label asp-for="Input.Street" class="ui-field__label">Ulica <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.Street" class="ui-field__input" required data-ticket-field />
                                <span asp-validation-for="Input.Street" class="ui-field__validation"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="ui-field">
                                <label asp-for="Input.HouseNumber" class="ui-field__label">Kucni broj <span style="color: var(--color-danger);">*</span></label>
                                <input asp-for="Input.HouseNumber" class="ui-field__input" required data-ticket-field />
                                <span asp-validation-for="Input.HouseNumber" class="ui-field__validation"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tb-loyalty-choice">
                    <label class="d-flex align-items-center gap-2">
                        <input asp-for="Input.IsLoyaltyMember" type="checkbox" />
                        <span>Zelim biti clan programa vjernosti</span>
                    </label>
                </div>

                <div class="ui-actions ui-actions--end tb-checkout-actions">
                    <a class="ui-btn ui-btn--secondary" asp-controller="TicketBuilder" asp-action="Seats"
                       asp-route-cinemaId="@Model.CinemaId" asp-route-movieId="@Model.MovieId"
                       asp-route-screeningId="@Model.ScreeningId">Natrag</a>
                    <button type="submit" class="ui-btn ui-btn--primary" data-ticket-submit>Potvrdi i kupi</button>
                </div>
            </form>
        </div>
    </div>
</div>
