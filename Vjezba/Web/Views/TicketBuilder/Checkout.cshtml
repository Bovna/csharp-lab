@model Vjezba.Web.ViewModels.TicketBuilderCheckoutViewModel
@{
    ViewData["Title"] = "Brza kupnja - Plaćanje";
}

<div class="tb-cinema tb-page">
    <div class="tb-header">
        <h1>@Model.MovieTitle</h1>
        <p>Korak 5/5: odaberi kupca i potvrdi kupnju</p>
        <small>@Model.HallName | @Model.StartTime.ToString("dd.MM.yyyy HH:mm") @(Model.Is3D ? "| 3D" : "")</small>
    </div>

    <div class="tb-step-line" aria-label="Koraci brze kupnje">
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Index">1 Kino</a>
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Movies"
           asp-route-cinemaId="@Model.CinemaId">2 Film</a>
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Screenings"
           asp-route-cinemaId="@Model.CinemaId" asp-route-movieId="@Model.MovieId">3 Projekcija</a>
        <a class="tb-step is-link" asp-controller="TicketBuilder" asp-action="Seats"
           asp-route-cinemaId="@Model.CinemaId" asp-route-movieId="@Model.MovieId"
           asp-route-screeningId="@Model.ScreeningId">4 Sjedalo</a>
        <span class="tb-step active" aria-current="step">5 Plaćanje</span>
    </div>

    <div class="tb-checkout-panel animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="tb-checkout-summary">
            <dl>
                <dt>Kino</dt>
                <dd>@Model.CinemaName</dd>
            </dl>

            <dl>
                <dt>Film</dt>
                <dd>@Model.MovieTitle</dd>
            </dl>

            <dl>
                <dt>Vrijeme</dt>
                <dd>@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <dl>
                <dt>Sjedalo</dt>
                <dd>@Model.SeatLabel (@Model.SeatType)</dd>
            </dl>

            <dl>
                <dt>Cijena</dt>
                <dd><strong>@Model.Price.ToString("0.00") EUR</strong></dd>
            </dl>
        </div>

        <form asp-controller="TicketBuilder" asp-action="Purchase" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CinemaId" value="@Model.CinemaId" />
            <input type="hidden" name="MovieId" value="@Model.MovieId" />
            <input type="hidden" name="ScreeningId" value="@Model.ScreeningId" />
            <input type="hidden" name="SeatId" value="@Model.SeatId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label for="CustomerId" class="form-label">Kupac</label>
                <select id="CustomerId" name="CustomerId" class="form-select" required>
                    <option value="">Odaberite kupca</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">@customer.FullName</option>
                    }
                </select>
            </div>

            <div class="ui-actions ui-actions--end tb-checkout-actions">
                <button type="submit" class="ui-btn ui-btn--primary">Potvrdi i kupi</button>
                <a class="ui-btn ui-btn--secondary" asp-controller="TicketBuilder" asp-action="Seats"
                   asp-route-cinemaId="@Model.CinemaId" asp-route-movieId="@Model.MovieId"
                   asp-route-screeningId="@Model.ScreeningId">Natrag</a>
            </div>
        </form>
    </div>
</div>
