@model KinoKlik.Model.Entities.Movie

@{
    ViewData["Title"] = "Detalji filma";
}

<div class="container py-4 animate-fade-in-up entity-details-page">
    <section class="entity-hero entity-hero--poster">
        <article class="movie-poster">
            <p class="movie-poster__eyebrow">Sada u fokusu</p>
            <h2 class="movie-poster__title">@Model.Title</h2>
            <p class="movie-poster__meta">@Model.Genre • @Model.DurationMinutes min • @Model.Language</p>
            <div class="movie-poster__rating">@Model.AgeRating</div>
            <p class="movie-poster__date">Premijera: @Model.ReleaseDate.ToString("dd.MM.yyyy")</p>
        </article>
        <div class="entity-hero__content">
            <p class="entity-hero__eyebrow">Film</p>
            <h1 class="entity-hero__title">@Model.Title</h1>
            <p class="entity-hero__subtitle">Poster-first prikaz s ključnim informacijama i brzim radnjama.</p>
            <div class="entity-meta">
                <span class="entity-pill">@Model.Genre</span>
                <span class="entity-pill">@Model.DurationMinutes min</span>
                <span class="entity-pill entity-pill--success">@Model.Language</span>
            </div>
            <div class="ui-actions ui-actions--stack-mobile">
                <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
                <a asp-controller="Screening" asp-action="Create" class="ui-btn ui-btn--primary">Dodajte projekciju</a>
            </div>
        </div>
    </section>

    <section class="entity-kpi-grid">
        <article class="entity-kpi">
            <p class="entity-kpi__label">Žanr</p>
            <p class="entity-kpi__value entity-kpi__value--accent">@Model.Genre</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">Trajanje</p>
            <p class="entity-kpi__value">@Model.DurationMinutes min</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">Dobna oznaka</p>
            <p class="entity-kpi__value">@Model.AgeRating</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">Datum izlaska</p>
            <p class="entity-kpi__value">@Model.ReleaseDate.ToString("dd.MM.yyyy")</p>
        </article>
    </section>

    <div class="entity-details-grid">
        <article class="cinema-card entity-details-panel">
            <div class="cinema-card-header">Profil filma</div>
            <div class="cinema-card-body">
                <dl class="cinema-details-list">
                    <dt>ID</dt>
                    <dd>@Model.Id</dd>

                    <dt>Naslov</dt>
                    <dd>@Model.Title</dd>

                    <dt>Žanr</dt>
                    <dd>@Model.Genre</dd>

                    <dt>Trajanje</dt>
                    <dd>@Model.DurationMinutes min</dd>

                    <dt>Jezik</dt>
                    <dd>@Model.Language</dd>

                    <dt>Dobna oznaka</dt>
                    <dd>@Model.AgeRating</dd>

                    <dt>Datum izlaska</dt>
                    <dd>@Model.ReleaseDate.ToString("dd.MM.yyyy")</dd>
                </dl>

                <div class="ui-actions ui-actions--center ui-actions--stack-mobile entity-actions">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="ui-btn ui-btn--primary">Uredi</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ui-btn ui-btn--danger"
                                onclick="return handleDeleteMovie(event);">Obriši</button>
                    </form>
                    }
                </div>
            </div>
        </article>

        <article class="cinema-card entity-details-panel">
            <div class="cinema-card-header">Sinopsis i raspored</div>
            <div class="cinema-card-body">
                <p class="entity-details-description">@Model.Description</p>
                <div class="entity-meta">
                    <span class="entity-pill">Jezik: @Model.Language</span>
                    <span class="entity-pill">Dobna oznaka: @Model.AgeRating</span>
                </div>
                <ul class="entity-link-list">
                    <li><a asp-controller="Screening" asp-action="Index">Provjerite raspored projekcija</a></li>
                    <li><a asp-controller="Screening" asp-action="Create">Dodajte novu projekciju filma</a></li>
                    <li><a asp-controller="TicketBuilder" asp-action="Index">Pokrenite brzu kupnju</a></li>
                </ul>
            </div>
        </article>
    </div>
</div>

@section Scripts {
    <script>
        function handleDeleteMovie(event) {
            event.preventDefault();
            const form = event.currentTarget.form;
            CinemaUI.showConfirm({
                title: 'Potvrdite brisanje',
                body: 'Jeste li sigurni da želite trajno obrisati ovaj film?',
                onConfirm: () => form.submit()
            });
            return false;
        }
    </script>
}
