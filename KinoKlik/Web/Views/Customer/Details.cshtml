@model KinoKlik.Web.ViewModels.CustomerDetailsViewModel

@{
    ViewData["Title"] = "Detalji kupca";
    var activeTickets = Model.Tickets.Count(t => t.Status == KinoKlik.Model.Entities.TicketStatus.Active);
    var totalSpent = Model.Tickets.Sum(t => t.Price);
}

<div class="container py-4 animate-fade-in-up entity-details-page">
    <section class="entity-hero entity-hero--customer">
        <div class="entity-hero__content">
            <p class="entity-hero__eyebrow">Kupac</p>
            <h1 class="entity-hero__title">@Model.Customer.FirstName @Model.Customer.LastName</h1>
            <p class="entity-hero__subtitle">@Model.Customer.City, registriran
                @Model.Customer.RegisteredAt.ToString("dd.MM.yyyy")</p>
                <div class="entity-meta">
                    <span
                        class="entity-pill @(Model.Customer.IsLoyaltyMember ? "entity-pill--success" : "entity-pill--muted")">
                        @(Model.Customer.IsLoyaltyMember ? "Program vjernosti aktivan" : "Bez programa vjernosti")
                    </span>
                    <span class="entity-pill">@Model.Customer.LoyaltyPoints bodova</span>
                </div>
            </div>
            <div class="ui-actions ui-actions--stack-mobile">
                <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
            </div>
        </section>

        <section class="member-pass">
            <article class="member-pass__card">
                <p class="member-pass__eyebrow">Članska kartica</p>
                <h2>@Model.Customer.FirstName @Model.Customer.LastName</h2>
                <p>@Model.Customer.Email</p>
                <p>@Model.Customer.Phone</p>
            </article>
        </section>

        <section class="entity-kpi-grid">
            <article class="entity-kpi">
                <p class="entity-kpi__label">Kupljene ulaznice</p>
                <p class="entity-kpi__value entity-kpi__value--accent">@Model.Tickets.Count</p>
            </article>
            <article class="entity-kpi">
                <p class="entity-kpi__label">Aktivne ulaznice</p>
                <p class="entity-kpi__value">@activeTickets</p>
            </article>
            <article class="entity-kpi">
                <p class="entity-kpi__label">Ukupna potrošnja</p>
                <p class="entity-kpi__value">@totalSpent.ToString("0.00") EUR</p>
            </article>
            <article class="entity-kpi">
                <p class="entity-kpi__label">Bodovi vjernosti</p>
                <p class="entity-kpi__value">@Model.Customer.LoyaltyPoints</p>
            </article>
        </section>

        <div class="entity-details-grid">
            <article class="cinema-card entity-details-panel">
                <div class="cinema-card-header">Profil kupca</div>
                <div class="cinema-card-body">
                    <dl class="cinema-details-list">
                        <dt>ID</dt>
                        <dd>@Model.Customer.Id</dd>

                        <dt>Ime i prezime</dt>
                        <dd>@Model.Customer.FirstName @Model.Customer.LastName</dd>

                        <dt>Adresa</dt>
                        <dd>@Model.Customer.Street @Model.Customer.HouseNumber, @Model.Customer.PostalCode
                            @Model.Customer.City</dd>

                            <dt>E-pošta</dt>
                            <dd>@Model.Customer.Email</dd>

                            <dt>Telefon</dt>
                            <dd>@Model.Customer.Phone</dd>

                            <dt>Datum registracije</dt>
                            <dd>@Model.Customer.RegisteredAt.ToString("dd.MM.yyyy")</dd>
                        </dl>

                        <div class="ui-actions ui-actions--center ui-actions--stack-mobile entity-actions">
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Customer.Id" class="ui-btn ui-btn--primary">Uredi</a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@Model.Customer.Id" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ui-btn ui-btn--danger"
                                            onclick="return handleDeleteCustomer(event);">Obriši</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>

                <article class="cinema-card entity-details-panel">
                    <div class="cinema-card-header">Članstvo</div>
                    <div class="cinema-card-body">
                        <div class="entity-meta">
                            @if (Model.Customer.IsLoyaltyMember)
                            {
                                <span class="entity-pill entity-pill--success">Član programa vjernosti</span>
                            }
                            else
                            {
                                <span class="entity-pill entity-pill--muted">Nije član programa vjernosti</span>
                            }
                            <span class="entity-pill">@Model.Customer.LoyaltyPoints bodova</span>
                        </div>
                        <ul class="entity-link-list">
                            <li><a asp-controller="Ticket" asp-action="Create">Ručno izdajte novu ulaznicu</a></li>
                            <li><a asp-controller="TicketBuilder" asp-action="Index">Pokrenite brzu kupnju</a></li>
                            <li><a asp-controller="Movie" asp-action="Index">Pregledajte dostupne filmove</a></li>
                        </ul>
                    </div>
                </article>
            </div>

            <article class="cinema-card animate-fade-in-up">
                <div class="cinema-card-header">Ulaznice kupca</div>
                <div class="cinema-table-wrapper">
                    @if (Model.Tickets.Any())
                    {
                        <table class="ui-table entity-related-table">
                            <thead>
                                <tr>
                                    <th>Broj ulaznice</th>
                                    <th>Film</th>
                                    <th>Projekcija</th>
                                    <th>Cijena</th>
                                    <th>Status</th>
                                    <th>Akcija</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.Tickets)
                                {
                                    <tr>
                                        <td>@ticket.TicketNumber</td>
                                        <td>@(ticket.Screening?.Movie?.Title ?? "-")</td>
                                        <td>@(ticket.Screening is null ? "-" : ticket.Screening.StartTime.ToString("dd.MM.yyyy HH:mm"))
                                        </td>
                                        <td>@ticket.Price.ToString("0.00") EUR</td>
                                        <td>
                                            @if (ticket.Status == KinoKlik.Model.Entities.TicketStatus.Active)
                                            {
                                                <span class="entity-pill entity-pill--success">Aktivna</span>
                                            }
                                            else if (ticket.Status == KinoKlik.Model.Entities.TicketStatus.Used)
                                            {
                                                <span class="entity-pill">Iskorištena</span>
                                            }
                                            else
                                            {
                                                <span class="entity-pill entity-pill--danger">Otkazana</span>
                                            }
                                        </td>
                                        <td><a asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id">Otvori</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="cinema-card-body">
                            <p class="text-muted mb-0">Kupac trenutno nema evidentiranih ulaznica.</p>
                        </div>
                    }
                </div>
            </article>


            @section Scripts {
                <script>
                        function handleDeleteCustomer(event) {
                            event.preventDefault();
                            const form = event.currentTarget.form;

                            if (!form) {
                                return false;
                            }
                            CinemaUI.showConfirm({
                                title: 'Potvrdite brisanje',
                                body: 'Jeste li sigurni da želite trajno obrisati ovog kupca?',
                                onConfirm: () => HTMLFormElement.prototype.submit.call(form)
                            });
                            return false;
                        }
                </script>
            }
