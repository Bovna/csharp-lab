@model List<KinoKlik.Model.Entities.Customer>

<div class="cinema-card animate-fade-in-up" data-ajax-search-results>
    <div class="cinema-card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <span class="cinema-badge">Prikazano: @Model.Count</span>
    </div>
    <div class="cinema-card-body p-0">
        <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
            <table class="ui-table entity-index-table customer-index-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ime</th>
                        <th>Prezime</th>
                        <th>Grad</th>
                        <th>E-posta</th>
                        <th>Registriran</th>
                        <th>Vjernost</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var customer in Model)
                        {
                            <tr>
                                <td class="text-muted">@customer.Id</td>
                                <td>@customer.FirstName</td>
                                <td>@customer.LastName</td>
                                <td>@customer.City</td>
                                <td>@customer.Email</td>
                                <td>@customer.RegisteredAt.ToString("dd.MM.yyyy")</td>
                                <td>@(customer.IsLoyaltyMember ? $"Da ({customer.LoyaltyPoints})" : "Ne")</td>
                                <td class="ui-table__actions">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-action="Details" asp-route-id="@customer.Id" class="ui-btn ui-btn--secondary"
                                           style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">Detalji</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Nema rezultata pretrage.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
