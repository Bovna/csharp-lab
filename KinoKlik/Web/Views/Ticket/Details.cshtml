@model KinoKlik.Model.Entities.Ticket

@{
    ViewData["Title"] = "Detalji ulaznice";
    var statusLabel = Model.Status switch
    {
        KinoKlik.Model.Entities.TicketStatus.Active => "Aktivna",
        KinoKlik.Model.Entities.TicketStatus.Cancelled => "Otkazana",
        KinoKlik.Model.Entities.TicketStatus.Used => "Iskorištena",
        _ => Model.Status.ToString()
    };
}

<div class="container py-4 animate-fade-in-up entity-details-page">
    <section class="entity-hero entity-hero--ticket">
        <div class="entity-hero__content">
            <p class="entity-hero__eyebrow">Ulaznica</p>
            <h1 class="entity-hero__title">@Model.TicketNumber</h1>
            <p class="entity-hero__subtitle">@(Model.Screening?.Movie?.Title ?? "-") •
                @Model.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</p>
                <div class="entity-meta">
                    <span class="entity-pill">Status: @statusLabel</span>
                    <span class="entity-pill entity-pill--success">@Model.Price.ToString("0.00") EUR</span>
                </div>
            </div>
            <div class="ui-actions ui-actions--stack-mobile">
                <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
                <button type="button" class="ui-btn ui-btn--primary" onclick="window.print()">Ispiši ulaznicu</button>
            </div>
        </section>

        <section class="ticket-stub" aria-label="Ispisni prikaz ulaznice">
            <div class="ticket-stub__main">
                <p class="ticket-stub__eyebrow">Kino ulaznica</p>
                <h2 class="ticket-stub__title">@(Model.Screening?.Movie?.Title ?? "-")</h2>
                <p class="ticket-stub__meta">@(Model.Screening?.Hall?.Cinema?.Name ?? "-") • @(Model.Screening?.Hall?.Name
                                    ?? "-")</p>
                    <dl class="ticket-stub__details">
                        <dt>Vrijeme</dt>
                        <dd>@(Model.Screening is null ? "-" : Model.Screening.StartTime.ToString("dd.MM.yyyy HH:mm"))</dd>
                        <dt>Sjedalo</dt>
                        <dd>@(Model.Seat is null ? "-" : $"{Model.Seat.RowLabel}{Model.Seat.SeatNumber}")</dd>
                        <dt>Kupac</dt>
                        <dd>@(Model.Customer is null ? "-" : $"{Model.Customer.FirstName} {Model.Customer.LastName}")</dd>
                    </dl>
                </div>
                <aside class="ticket-stub__tear">
                    <p class="ticket-stub__number">@Model.TicketNumber</p>
                    <p class="ticket-stub__price">@Model.Price.ToString("0.00") EUR</p>
                    <div class="ticket-stub__barcode" aria-hidden="true"></div>
                    <p class="ticket-stub__status">@statusLabel</p>
                </aside>
            </section>

            <section class="entity-kpi-grid">
                <article class="entity-kpi">
                    <p class="entity-kpi__label">Status</p>
                    <p class="entity-kpi__value entity-kpi__value--accent">@statusLabel</p>
                </article>
                <article class="entity-kpi">
                    <p class="entity-kpi__label">Cijena</p>
                    <p class="entity-kpi__value">@Model.Price.ToString("0.00") EUR</p>
                </article>
                <article class="entity-kpi">
                    <p class="entity-kpi__label">Sjedalo</p>
                    <p class="entity-kpi__value">@(Model.Seat is null ? "-" : $"{Model.Seat.RowLabel}{Model.Seat.SeatNumber}")
                    </p>
                </article>
            </section>

            <div class="entity-details-grid">
                <article class="cinema-card entity-details-panel">
                    <div class="cinema-card-header">Detalji ulaznice</div>
                    <div class="cinema-card-body">
                        <dl class="cinema-details-list">
                            <dt>ID</dt>
                            <dd>@Model.Id</dd>

                            <dt>Broj ulaznice</dt>
                            <dd>@Model.TicketNumber</dd>

                            <dt>Kupac</dt>
                            <dd>@(Model.Customer is null ? "-" : $"{Model.Customer.FirstName} {Model.Customer.LastName}")</dd>

                            <dt>Film</dt>
                            <dd>@(Model.Screening?.Movie?.Title ?? "-")</dd>

                            <dt>Kino</dt>
                            <dd>@(Model.Screening?.Hall?.Cinema?.Name ?? "-")</dd>

                            <dt>Dvorana</dt>
                            <dd>@(Model.Screening?.Hall?.Name ?? "-")</dd>

                            <dt>Sjedalo</dt>
                            <dd>@(Model.Seat is null ? "-" : $"{Model.Seat.RowLabel}{Model.Seat.SeatNumber}")</dd>

                            <dt>Kupnja</dt>
                            <dd>@Model.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                            <dt>Cijena</dt>
                            <dd>@Model.Price.ToString("0.00") EUR</dd>
                        </dl>

                        <div class="ui-actions ui-actions--center ui-actions--stack-mobile entity-actions">
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="ui-btn ui-btn--primary">Uredi</a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ui-btn ui-btn--danger"
                                            onclick="return handleDeleteTicket(event);">Obriši</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>

                <article class="cinema-card entity-details-panel">
                    <div class="cinema-card-header">Status i poveznice</div>
                    <div class="cinema-card-body">
                        <div class="entity-meta">
                            @if (Model.Status == KinoKlik.Model.Entities.TicketStatus.Active)
                            {
                                <span class="entity-pill entity-pill--success">Aktivna</span>
                            }
                            else if (Model.Status == KinoKlik.Model.Entities.TicketStatus.Cancelled)
                            {
                                <span class="entity-pill entity-pill--danger">Otkazana</span>
                            }
                            else
                            {
                                <span class="entity-pill">Iskorištena</span>
                            }
                            <span class="entity-pill">@Model.Price.ToString("0.00") EUR</span>
                        </div>
                        <ul class="entity-link-list">
                            @if (Model.Customer is not null)
                            {
                                <li><a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.Customer.Id">Detalji
                                    kupca</a></li>
                                }
                                @if (Model.Screening is not null)
                                {
                                    <li><a asp-controller="Screening" asp-action="Details" asp-route-id="@Model.Screening.Id">Detalji
                                        projekcije</a></li>
                                    }
                                    @if (Model.Seat is not null)
                                    {
                                        <li><a asp-controller="Seat" asp-action="Details" asp-route-id="@Model.Seat.Id">Detalji sjedala</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </article>
                    </div>
                </div>

                @section Scripts {
                    <script>
                        function handleDeleteTicket(event) {
                            event.preventDefault();
                            const form = event.currentTarget.form;

                            if (!form) {
                                return false;
                            }
                            CinemaUI.showConfirm({
                                title: 'Potvrdite brisanje',
                                body: 'Jeste li sigurni da želite trajno obrisati ovu ulaznicu?',
                                onConfirm: () => HTMLFormElement.prototype.submit.call(form)
                            });
                            return false;
                        }
                    </script>
                }
