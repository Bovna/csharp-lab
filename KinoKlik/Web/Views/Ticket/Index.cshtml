@model List<KinoKlik.Model.Entities.Ticket>

@{
    ViewData["Title"] = "Ulaznice";
    var selectedStatus = ViewBag.SelectedStatus as string;
    var search = ViewBag.Search as string;
}

<div class="py-4 animate-fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
        <div>
            <h1 class="h3 mb-1" style="color: var(--color-accent); letter-spacing: 1px; text-transform: uppercase;">Popis ulaznica</h1>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="ui-btn ui-btn--primary">+ Dodaj novu ulaznicu</a>
        }
    </div>

    <div class="cinema-card animate-fade-in-up mb-4" style="animation-delay: 0.05s;">
        <div class="cinema-card-header">Pretrazivanje</div>
        <div class="cinema-card-body">
            <form asp-action="Search" method="get" class="ui-form entity-index-search"
                  data-ajax-search-form data-ajax-results-target="#ticket-index-results">
                <div class="row g-4 align-items-end">
                    <div class="col-12 col-lg-7">
                        <div class="ui-field mb-0">
                            <label for="ticketSearch" class="ui-field__label">Broj ulaznice, kupac ili film</label>
                            <input id="ticketSearch" name="query" value="@search" class="ui-field__input" type="search"
                                   placeholder="Pretrazite ulaznice..." autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-5">
                        <div class="ui-field mb-0">
                            <label for="status" class="ui-field__label">Status</label>
                            <select id="status" name="status" class="ui-field__input">
                                <option value="">Svi statusi</option>
                                <option value="Active" selected="@(string.Equals(selectedStatus, "Active", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Aktivna</option>
                                <option value="Cancelled" selected="@(string.Equals(selectedStatus, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Otkazana</option>
                                <option value="Used" selected="@(string.Equals(selectedStatus, "Used", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Iskoristena</option>
                            </select>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="ticket-index-results" data-ajax-search-results-container>
        @await Html.PartialAsync("_IndexResults", Model)
    </div>
</div>
