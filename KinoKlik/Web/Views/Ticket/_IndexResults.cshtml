@model List<KinoKlik.Model.Entities.Ticket>

<div class="cinema-card animate-fade-in-up" data-ajax-search-results>
    <div class="cinema-card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <span class="cinema-badge">Prikazano: @Model.Count</span>
    </div>
    <div class="cinema-card-body p-0">
        <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
            <table class="ui-table entity-index-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Broj ulaznice</th>
                        <th>Vrijeme projekcije</th>
                        <th>Cijena</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var ticket in Model)
                        {
                            var statusLabel = ticket.Status switch
                            {
                                KinoKlik.Model.Entities.TicketStatus.Active => "Aktivna",
                                KinoKlik.Model.Entities.TicketStatus.Cancelled => "Otkazana",
                                KinoKlik.Model.Entities.TicketStatus.Used => "Iskoristena",
                                _ => ticket.Status.ToString()
                            };

                            <tr>
                                <td class="text-muted">@ticket.Id</td>
                                <td>@ticket.TicketNumber</td>
                                <td>@(ticket.Screening is null ? "-" : ticket.Screening.StartTime.ToString("dd.MM.yyyy HH:mm"))</td>
                                <td>@ticket.Price.ToString("0.00")</td>
                                <td>@statusLabel</td>
                                <td class="ui-table__actions">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-action="Details" asp-route-id="@ticket.Id" class="ui-btn ui-btn--secondary"
                                           style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">Detalji</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Nema rezultata pretrage.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
