@model KinoKlik.Model.Entities.Seat

@{
    ViewData["Title"] = "Detalji sjedala";
}

<div class="container py-4 animate-fade-in-up entity-details-page">
    <section class="entity-hero entity-hero--seat">
        <div class="entity-hero__content">
            <p class="entity-hero__eyebrow">Sjedalo</p>
            <h1 class="entity-hero__title">@Model.RowLabel@Model.SeatNumber</h1>
            <p class="entity-hero__subtitle">@(Model.Hall?.Cinema?.Name ?? "-") / @(Model.Hall?.Name ?? "-")</p>
            <div class="entity-meta">
                <span class="entity-pill">Red: @Model.RowLabel</span>
                <span class="entity-pill">Mjesto: @Model.SeatNumber</span>
                <span class="entity-pill entity-pill--success">Tip: @Model.SeatType</span>
            </div>
        </div>
        <div class="ui-actions ui-actions--stack-mobile">
            <a asp-action="Index" class="ui-btn ui-btn--secondary">Natrag na popis</a>
        </div>
    </section>

    <section class="entity-kpi-grid">
        <article class="entity-kpi">
            <p class="entity-kpi__label">Red</p>
            <p class="entity-kpi__value entity-kpi__value--accent">@Model.RowLabel</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">Broj</p>
            <p class="entity-kpi__value">@Model.SeatNumber</p>
        </article>
        <article class="entity-kpi">
            <p class="entity-kpi__label">Tip sjedala</p>
            <p class="entity-kpi__value">@Model.SeatType</p>
        </article>
    </section>

    <div class="entity-details-grid">
        <article class="cinema-card entity-details-panel">
            <div class="cinema-card-header">Detalji sjedala</div>
            <div class="cinema-card-body">
                <dl class="cinema-details-list">
                    <dt>ID</dt>
                    <dd>@Model.Id</dd>

                    <dt>Kino</dt>
                    <dd>@(Model.Hall?.Cinema?.Name ?? "-")</dd>

                    <dt>Dvorana</dt>
                    <dd>@(Model.Hall?.Name ?? "-")</dd>

                    <dt>Red</dt>
                    <dd>@Model.RowLabel</dd>

                    <dt>Broj sjedala</dt>
                    <dd>@Model.SeatNumber</dd>

                    <dt>Tip sjedala</dt>
                    <dd>@Model.SeatType</dd>
                </dl>

                <div class="ui-actions ui-actions--center ui-actions--stack-mobile entity-actions">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="ui-btn ui-btn--primary">Uredi</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ui-btn ui-btn--danger"
                                    onclick="return handleDeleteSeat(event);">Obriši</button>
                        </form>
                    }
                </div>
            </div>
        </article>

        <article class="cinema-card entity-details-panel">
            <div class="cinema-card-header">Povezano</div>
            <div class="cinema-card-body">
                <div class="entity-meta">
                    <span class="entity-pill">Oznaka: @Model.RowLabel@Model.SeatNumber</span>
                    <span class="entity-pill entity-pill--success">@Model.SeatType</span>
                </div>
                <ul class="entity-link-list">
                    @if (Model.Hall is not null)
                    {
                        <li><a asp-controller="Hall" asp-action="Details" asp-route-id="@Model.Hall.Id">Detalji dvorane</a>
                        </li>
                    }
                    @if (Model.Hall?.Cinema is not null)
                    {
                        <li><a asp-controller="Cinema" asp-action="Details" asp-route-id="@Model.Hall.Cinema.Id">Detalji
                            kina</a></li>
                        }
                        <li><a asp-controller="Ticket" asp-action="Create">Izdajte ulaznicu za ovo sjedalo</a></li>
                    </ul>
                </div>
            </article>
        </div>
    </div>

    @section Scripts {
        <script>
            function handleDeleteSeat(event) {
                event.preventDefault();
                const form = event.currentTarget.form;

                if (!form) {
                    return false;
                }
                CinemaUI.showConfirm({
                    title: 'Potvrdite brisanje',
                    body: 'Jeste li sigurni da želite trajno obrisati ovo sjedalo?',
                    onConfirm: () => HTMLFormElement.prototype.submit.call(form)
                });
                return false;
            }
        </script>
    }
