@model KinoKlik.Web.ViewModels.SeatFormViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
}

@if (isEdit)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="RowLabel" class="ui-field__label">Oznaka reda <span style="color: var(--color-danger);">*</span></label><input asp-for="RowLabel" class="ui-field__input" maxlength="1" pattern="[A-Z]" oninvalid="this.setCustomValidity(this.validity.valueMissing ? 'Oznaka reda je obavezna.' : 'Oznaka reda mora biti veliko slovo.')" oninput="this.setCustomValidity('')" required /><span asp-validation-for="RowLabel" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="SeatNumber" class="ui-field__label">Broj sjedala <span style="color: var(--color-danger);">*</span></label><input asp-for="SeatNumber" class="ui-field__input" type="number" min="1" data-msg-min="Broj sjedala mora biti veći od ili jednak 1." oninvalid="this.setCustomValidity(this.validity.rangeUnderflow ? 'Broj sjedala mora biti veći od ili jednak 1.' : 'Broj sjedala je obavezan.')" oninput="this.setCustomValidity('')" required /><span asp-validation-for="SeatNumber" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="SeatType" class="ui-field__label">Tip sjedala <span style="color: var(--color-danger);">*</span></label><select asp-for="SeatType" class="ui-field__input" asp-items="Html.GetEnumSelectList<KinoKlik.Model.Entities.SeatType>()" required></select><span asp-validation-for="SeatType" class="ui-field__validation"></span></div>
            </div>
            <div class="col-12">@await Html.PartialAsync("_AutocompleteSelect", Model.HallSelector)</div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ui-btn ui-btn--secondary">Odustani</a>
        </div>
    </form>
}
else
{
    <form asp-action="Create" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="RowLabel" class="ui-field__label">Oznaka reda <span style="color: var(--color-danger);">*</span></label><input asp-for="RowLabel" class="ui-field__input" maxlength="1" pattern="[A-Z]" oninvalid="this.setCustomValidity(this.validity.valueMissing ? 'Oznaka reda je obavezna.' : 'Oznaka reda mora biti veliko slovo.')" oninput="this.setCustomValidity('')" required /><span asp-validation-for="RowLabel" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="SeatNumber" class="ui-field__label">Broj sjedala <span style="color: var(--color-danger);">*</span></label><input asp-for="SeatNumber" class="ui-field__input" type="number" min="1" data-msg-min="Broj sjedala mora biti veći od ili jednak 1." oninvalid="this.setCustomValidity(this.validity.rangeUnderflow ? 'Broj sjedala mora biti veći od ili jednak 1.' : 'Broj sjedala je obavezan.')" oninput="this.setCustomValidity('')" required /><span asp-validation-for="SeatNumber" class="ui-field__validation"></span></div>
            </div>
            <div class="col-md-4">
                <div class="ui-field"><label asp-for="SeatType" class="ui-field__label">Tip sjedala <span style="color: var(--color-danger);">*</span></label><select asp-for="SeatType" class="ui-field__input" asp-items="Html.GetEnumSelectList<KinoKlik.Model.Entities.SeatType>()" required></select><span asp-validation-for="SeatType" class="ui-field__validation"></span></div>
            </div>
            <div class="col-12">@await Html.PartialAsync("_AutocompleteSelect", Model.HallSelector)</div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <a asp-action="Index" class="ui-btn ui-btn--secondary">Odustani</a>
            <button type="submit" class="ui-btn ui-btn--primary">Spremi sjedalo</button>
        </div>
    </form>
}
