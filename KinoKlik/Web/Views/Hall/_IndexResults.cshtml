@model List<KinoKlik.Model.Entities.Hall>

<div class="cinema-card animate-fade-in-up" data-ajax-search-results>
    <div class="cinema-card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <span class="cinema-badge">Prikazano: @Model.Count</span>
    </div>
    <div class="cinema-card-body p-0">
        <div class="cinema-table-wrapper cinema-table-wrapper--no-scroll">
            <table class="ui-table entity-index-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Naziv</th>
                        <th>Kino</th>
                        <th>Kapacitet</th>
                        <th>3D podrska</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var hall in Model)
                        {
                            <tr>
                                <td class="text-muted">@hall.Id</td>
                                <td>@hall.Name</td>
                                <td>@(hall.Cinema?.Name ?? "-")</td>
                                <td>@hall.Capacity</td>
                                <td>@(hall.Supports3D ? "Da" : "Ne")</td>
                                <td class="ui-table__actions">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-action="Details" asp-route-id="@hall.Id" class="ui-btn ui-btn--secondary"
                                           style="font-size: 0.9rem; padding: 0.4rem 0.8rem;">Detalji</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Nema rezultata pretrage.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
