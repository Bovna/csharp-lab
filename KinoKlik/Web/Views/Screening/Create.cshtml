@model KinoKlik.Web.ViewModels.ScreeningFormViewModel

@{
    ViewData["Title"] = "Dodaj projekciju";
    ViewData["IsEdit"] = false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-8 entity-form movie-page-form">
            <div class="cinema-card animate-fade-in-up">
                <div class="cinema-card-header">Dodaj novu projekciju</div>
                <div class="cinema-card-body">
                    <partial name="ScreeningForm" model="Model" view-data="ViewData" />
                </div>
            </div>
        </div>
    </div>
</div>
