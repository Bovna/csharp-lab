@model KinoKlik.Web.ViewModels.CinemaFormViewModel

@{
    ViewData["Title"] = "Dodaj kino";
    ViewData["IsEdit"] = false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 entity-form">
            <div class="cinema-card animate-fade-in-up">
                <div class="cinema-card-header">Dodaj novo kino</div>
                <div class="cinema-card-body" style="padding: 32px;">
                    <partial name="CinemaForm" model="Model" view-data="ViewData" />
                </div>
            </div>
        </div>
    </div>
</div>
