@model KinoKlik.Web.ViewModels.CinemaFormViewModel

@{
    var isEdit = (ViewData["IsEdit"] as bool?) == true;
}

@if (isEdit)
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="mb-4">
            <h5 class="ui-form__section-title">Osnovne informacije</h5>
            <div class="ui-field">
                <label asp-for="Name" class="ui-field__label">Naziv kina <span style="color: var(--color-danger);">*</span></label>
                <input asp-for="Name" class="ui-field__input" placeholder="npr. Cinestar Zagreb" required />
                <span asp-validation-for="Name" class="ui-field__validation"></span>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="City" class="ui-field__label">Grad <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="City" class="ui-field__input" placeholder="npr. Zagreb" required />
                        <span asp-validation-for="City" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="PostalCode" class="ui-field__label">Poštanski broj <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="PostalCode" class="ui-field__input" placeholder="npr. 10000" required />
                        <span asp-validation-for="PostalCode" class="ui-field__validation"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <h5 class="ui-form__section-title">Adresa i kontakt</h5>
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="ui-field">
                        <label asp-for="Street" class="ui-field__label">Ulica <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="Street" class="ui-field__input" placeholder="npr. Ilica" required />
                        <span asp-validation-for="Street" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ui-field">
                        <label asp-for="HouseNumber" class="ui-field__label">Kućni broj <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="HouseNumber" class="ui-field__input" placeholder="npr. 10" required />
                        <span asp-validation-for="HouseNumber" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="Email" class="ui-field__label">E-pošta <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="Email" class="ui-field__input" placeholder="npr. info@cinemaxx.hr" required />
                        <span asp-validation-for="Email" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="Phone" class="ui-field__label">Telefon <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="Phone" class="ui-field__input" placeholder="npr. +385 1 123 4567" required />
                        <span asp-validation-for="Phone" class="ui-field__validation"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <button type="submit" class="ui-btn ui-btn--primary">Spremi promjene</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="ui-btn ui-btn--secondary">Odustani</a>
        </div>
    </form>
}
else
{
    <form asp-action="Create" method="post" class="ui-form" onsubmit="return CinemaUI.validateForm(this);">
        <div asp-validation-summary="ModelOnly" class="ui-validation-summary mb-3" aria-live="polite"></div>

        <div class="mb-4">
            <h5 class="ui-form__section-title">Osnovne informacije</h5>
            <div class="ui-field">
                <label asp-for="Name" class="ui-field__label">Naziv kina <span style="color: var(--color-danger);">*</span></label>
                <input asp-for="Name" class="ui-field__input" placeholder="npr. Cinestar Zagreb" required />
                <span asp-validation-for="Name" class="ui-field__validation"></span>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="City" class="ui-field__label">Grad <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="City" class="ui-field__input" placeholder="npr. Zagreb" required />
                        <span asp-validation-for="City" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="PostalCode" class="ui-field__label">Poštanski broj <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="PostalCode" class="ui-field__input" placeholder="npr. 10000" required />
                        <span asp-validation-for="PostalCode" class="ui-field__validation"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <h5 class="ui-form__section-title">Adresa i kontakt</h5>
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="ui-field">
                        <label asp-for="Street" class="ui-field__label">Ulica <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="Street" class="ui-field__input" placeholder="npr. Ilica" required />
                        <span asp-validation-for="Street" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="ui-field">
                        <label asp-for="HouseNumber" class="ui-field__label">Kućni broj <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="HouseNumber" class="ui-field__input" placeholder="npr. 10" required />
                        <span asp-validation-for="HouseNumber" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="Email" class="ui-field__label">E-pošta <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="Email" class="ui-field__input" placeholder="npr. info@cinemaxx.hr" required />
                        <span asp-validation-for="Email" class="ui-field__validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ui-field">
                        <label asp-for="Phone" class="ui-field__label">Telefon <span style="color: var(--color-danger);">*</span></label>
                        <input asp-for="Phone" class="ui-field__input" placeholder="npr. +385 1 123 4567" required />
                        <span asp-validation-for="Phone" class="ui-field__validation"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="ui-actions ui-actions--end ui-actions--stack-mobile mt-4 pt-3 border-top">
            <a asp-action="Index" class="ui-btn ui-btn--secondary">Odustani</a>
            <button type="submit" class="ui-btn ui-btn--primary">Spremi kino</button>
        </div>
    </form>
}